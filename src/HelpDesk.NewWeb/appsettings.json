{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DataProtection": {
    "ApplicationName": "RatelDesk"
  },
  "ApiBaseUrl": "https://api.helpdesk.example.com/",
  "AppBar": {
    "BuildVersion": "0.1.0"
  },
  "ReverseProxy": {
    "Routes": {
      "api-openapi-route": {
        "ClusterId": "apiCluster",
        "Match": {
          "Path": "/api/openapi/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          },
          {
            "RequestHeader": "X-Forwarded-Prefix",
            "Set": "/api"
          }
        ]
      },
      "api-v1-route": {
        "ClusterId": "apiCluster",
        "Match": {
          "Path": "/api/v1/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeader": "X-Forwarded-Prefix",
            "Set": "/api"
          }
        ]
      },
      "api-incidents-assets-route": {
        "ClusterId": "apiCluster",
        "Match": {
          "Path": "/api/incidents/{**catch-all}"
        }
      },
      "api-worklogs-assets-route": {
        "ClusterId": "apiCluster",
        "Match": {
          "Path": "/api/worklogs/{**catch-all}"
        }
      },
      "api-email-template-assets-route": {
        "ClusterId": "apiCluster",
        "Match": {
          "Path": "/api/email-templates/{**catch-all}"
        }
      },
      "api-tenant-branding-assets-route": {
        "ClusterId": "apiCluster",
        "Match": {
          "Path": "/api/tenants/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "apiCluster": {
        "Destinations": {
          "api1": {
            "Address": "http://127.0.0.1:8222/"
          }
        }
      }
    }
  },
  "LoginUi": {
    "EnvironmentLabel": "Self-hosted"
  },
  "SystemToken": {
    "Issuer": "https://id.example.com/application/o/rateldesk/",
    "Audience": "rateldesk-api"
  },
  "Authentication": {
    "Authentik": {
      "Authority": "https://id.example.com/application/o/rateldesk/",
      "ClientId": "",
      "ResponseType": "code",
      "ApiScope": "rateldesk-api",
      "CallbackPath": "/signin-authentik",
      "SignedOutCallbackPath": "/signout-authentik",
      "SecretStorePath": ""
    },
    "AuthentikAiAgent": {
      "Enabled": false,
      "Authority": "",
      "ClientId": "",
      "Audience": "",
      "CallbackPath": "/signin-authentik-ai-agent",
      "SecretStorePath": "",
      "RequiredGroups": [],
      "SessionRoles": []
    }
  },
  "AI": {
    "DefaultEmbeddingModel": "text-embedding-3-small",
    "DefaultEmbeddingDimensions": 1536
  }
}
