@page "/account/change-password"

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>Change passphrase</PageTitle>

<section class="helpdesk-login-page">
    <MudPaper Elevation="2" Class="helpdesk-login-panel">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h4" HtmlTag="h1">Change passphrase</MudText>
            <MudText Typo="Typo.body1">Changing your passphrase signs out this browser session.</MudText>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error">@_error</MudAlert>
            }

            <MudTextField T="string" @bind-Value="_currentPassword" Label="Current passphrase" InputType="InputType.Password" Required="true" />
            <MudTextField T="string" @bind-Value="_newPassword" Label="New passphrase" InputType="InputType.Password" Required="true" HelperText="Use a memorable passphrase of at least 15 characters." />
            <MudTextField T="string" @bind-Value="_confirmPassword" Label="Confirm new passphrase" InputType="InputType.Password" Required="true" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="ChangePasswordAsync">
                @(_busy ? "Changing…" : "Change passphrase")
            </MudButton>
        </MudStack>
    </MudPaper>
</section>

@code {
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _error;
    private bool _busy;

    private async Task ChangePasswordAsync()
    {
        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            _error = "The new passphrases do not match.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            using var response = await HttpClientFactory.CreateClient("HelpdeskApi").PostAsJsonAsync(
                "api/v1/local-auth/change-password",
                new { currentPassword = _currentPassword, newPassword = _newPassword });
            if (!response.IsSuccessStatusCode)
            {
                _error = "The current passphrase or new passphrase was not accepted.";
                return;
            }

            _currentPassword = string.Empty;
            _newPassword = string.Empty;
            _confirmPassword = string.Empty;
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _error = "The account service is unavailable. Please retry.";
        }
        finally
        {
            _busy = false;
        }
    }
}
