@page "/account/change-password"
@attribute [Authorize]

@inject IJSRuntime JS
@using System.Text.Json
@implements IAsyncDisposable
@inject NavigationManager Navigation

<PageTitle>Change passphrase</PageTitle>

<section class="helpdesk-login-page">
    <MudPaper Elevation="2" Class="helpdesk-login-panel">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h4" HtmlTag="h1">Change passphrase</MudText>
            <MudText Typo="Typo.body1">Changing your passphrase signs out this browser session.</MudText>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error">@_error</MudAlert>
            }

            <MudTextField T="string" Disabled="@(!RendererInfo.IsInteractive || _busy)" @bind-Value="_currentPassword" Label="Current passphrase" InputType="InputType.Password" Required="true" />
            <MudTextField T="string" Disabled="@(!RendererInfo.IsInteractive || _busy)" @bind-Value="_newPassword" Label="New passphrase" InputType="InputType.Password" Required="true" HelperText="Use a memorable passphrase of at least 15 characters." />
            <MudTextField T="string" Disabled="@(!RendererInfo.IsInteractive || _busy)" @bind-Value="_confirmPassword" Label="Confirm new passphrase" InputType="InputType.Password" Required="true" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || !RendererInfo.IsInteractive)" OnClick="ChangePasswordAsync">
                @(_busy ? "Changing…" : "Change passphrase")
            </MudButton>
        </MudStack>
    </MudPaper>
</section>

@code {
    private IJSObjectReference? accountModule;
    private async Task<BrowserAccountResponse> PostAccountAsync(string endpoint, object body)
    {
        accountModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/local-account.js");
        return await accountModule.InvokeAsync<BrowserAccountResponse>("post", endpoint, body);
    }
    public async ValueTask DisposeAsync()
    {
        if (accountModule is not null)
        {
            try { await accountModule.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
    private sealed record BrowserAccountResponse(bool Ok, int Status, string Body);

    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _error;
    private bool _busy;

    private async Task ChangePasswordAsync()
    {
        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            _error = "The new passphrases do not match.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var response = await PostAccountAsync(
                "/api/v1/local-auth/change-password",
                new { currentPassword = _currentPassword, newPassword = _newPassword });
            if (!response.Ok)
            {
                _error = "The current passphrase or new passphrase was not accepted.";
                return;
            }

            _currentPassword = string.Empty;
            _newPassword = string.Empty;
            _confirmPassword = string.Empty;
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (JSException)
        {
            _error = "The account service is unavailable. Please retry.";
        }
        finally
        {
            _busy = false;
        }
    }
}
