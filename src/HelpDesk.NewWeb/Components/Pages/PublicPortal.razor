@page "/"
@layout PublicLayout
@attribute [AllowAnonymous]
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory
@using System.Net.Http.Json

<PageTitle>@_branding.ApplicationName Portal</PageTitle>
<HeadContent><link rel="icon" href="@_branding.FaviconUrl" /></HeadContent>

<section class="helpdesk-portal-page">
    <div class="helpdesk-portal-admin">
        <MudButton Href="/login"
                   Variant="Variant.Text"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Lock">
            Admin sign-in
        </MudButton>
    </div>

    <MudContainer MaxWidth="MaxWidth.Medium" Class="helpdesk-portal-content">
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="helpdesk-portal-signature">
            <img class="helpdesk-portal-logo" src="@_branding.CompactLogoUrl" alt="@_branding.ApplicationName" />
            <MudText Typo="Typo.caption" HtmlTag="p" Class="helpdesk-portal-company">@_branding.OrganizationName</MudText>
        </MudStack>

        <MudText Typo="Typo.h3" HtmlTag="h1" GutterBottom="true" Align="Align.Center">Welcome to @_branding.ApplicationName</MudText>
        <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Secondary" Class="mb-12">@(_branding.Tagline ?? "How can we help you today?")</MudText>

        <MudGrid Justify="Justify.Center" Spacing="4">
            <MudItem xs="12" sm="6" md="5">
                <MudCard Elevation="0"
                         Class="helpdesk-portal-action"
                         @onclick="@(() => Navigation.NavigateTo("/submit-ticket"))">
                    <MudCardActions>
                        <div class="pa-6 text-center">
                            <MudIcon Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Class="helpdesk-portal-action-icon" />
                            <MudText Typo="Typo.h5" Class="mt-4">Submit a New Ticket</MudText>
                            <MudText Typo="Typo.body1" Class="mt-2">Need help? Create a ticket and we'll get right on it.</MudText>
                        </div>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="5">
                <MudCard Elevation="0"
                         Class="helpdesk-portal-action"
                         @onclick="@(() => Navigation.NavigateTo("/view-ticket"))">
                    <MudCardActions>
                        <div class="pa-6 text-center">
                            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Success" Class="helpdesk-portal-action-icon" />
                            <MudText Typo="Typo.h5" Class="mt-4">View Existing Tickets</MudText>
                            <MudText Typo="Typo.body1" Class="mt-2">Check the status of your previously submitted tickets.</MudText>
                        </div>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudContainer>
</section>

@code {
    private BrandingSnapshot _branding = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _branding = await HttpClientFactory.CreateClient("HelpdeskApi")
                .GetFromJsonAsync<BrandingSnapshot>("api/v1/branding") ?? _branding;
        }
        catch (HttpRequestException exception)
        {
            System.Diagnostics.Debug.WriteLine($"Branding endpoint unavailable while rendering the public portal: {exception.Message}");
        }
    }

    private sealed class BrandingSnapshot
    {
        public string ApplicationName { get; set; } = "RatelDesk";
        public string OrganizationName { get; set; } = "RatelDesk";
        public string CompactLogoUrl { get; set; } = "/branding/rateldesk-mark.svg";
        public string? Tagline { get; set; } = "How can we help you today?";
        public string FaviconUrl { get; set; } = "/favicon.ico";
    }
}
