@using System.ComponentModel.DataAnnotations
@using Helpdesk.Shared.DTOs.Organization
@using Helpdesk.Shared.DTOs.SupportNotifications

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(Group is null ? Icons.Material.Filled.AddCircle : Icons.Material.Filled.Edit)" Class="mr-2 mb-n1" />
            @(Group is null ? "Create Support Group" : "Edit Support Group")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" Model="model" Class="mt-2">
            <MudSelect T="string"
                       @bind-Value="model.OwningOrganizationId"
                       Label="Owning organization"
                       Required="true"
                       Dense="true">
                @foreach (var organization in Organizations.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase))
                {
                    <MudSelectItem T="string" Value="@organization.Id">@organization.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="model.Name" Label="Name" Required="true" />
            <MudTextField @bind-Value="model.Description" Label="Description" Lines="2" />
            <MudSwitch T="bool" @bind-Value="model.IsEnabled" Label="Enabled" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public SupportGroupDto? Group { get; set; }
    [Parameter] public List<OrganizationDto> Organizations { get; set; } = new();
    [Parameter] public string? DefaultOwningOrganizationId { get; set; }

    private MudForm form = default!;
    private SupportGroupFormModel model = new();

    protected override void OnInitialized()
    {
        model = new SupportGroupFormModel
        {
            OwningOrganizationId = Group?.OwningOrganizationId
                ?? DefaultOwningOrganizationId
                ?? Organizations.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase).FirstOrDefault()?.Id
                ?? string.Empty,
            Name = Group?.Name ?? string.Empty,
            Description = Group?.Description,
            IsEnabled = Group?.IsEnabled ?? true
        };
    }

    private async Task Submit()
    {
        await form.Validate();
        if (!form.IsValid)
        {
            return;
        }

        Dialog.Close(DialogResult.Ok(model));
    }

    private void Cancel() => Dialog.Cancel();

    public sealed class SupportGroupFormModel
    {
        [Required] public string OwningOrganizationId { get; set; } = string.Empty;
        [Required] public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool IsEnabled { get; set; } = true;
    }
}
