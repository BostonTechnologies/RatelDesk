@using HelpDesk.NewWeb.Services
@using Helpdesk.Shared.DTOs.Organization
@using Helpdesk.Shared.DTOs.SupportNotifications
@using Helpdesk.Shared.DTOs.User
@using Helpdesk.Shared.Enums
@inject ISupportNotificationAdminClient Client
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
        <div>
            <MudText Typo="Typo.h6">Notification Rules</MudText>
            <MudText Typo="Typo.body2" Class="text-secondary">Rules decide who receives outbound support email for this organization.</MudText>
        </div>
        <MudSpacer />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@string.IsNullOrWhiteSpace(SelectedOrganizationId)"
                   OnClick="OpenCreateDialogAsync">
            Add Rule
        </MudButton>
    </MudStack>

    @if (Rows.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            No notification rules are configured for this organization.
        </MudAlert>
    }
    else
    {
        <MudStack Spacing="2">
            @foreach (var row in Rows.OrderByDescending(x => x.IsEnabled).ThenBy(x => x.EventType).ThenBy(RecipientName))
            {
                <MudPaper Outlined="true" Class="pa-3">
                    <MudGrid Spacing="2" AlignItems="Center">
                        <MudItem xs="12" md="8">
                            <MudText Typo="Typo.body1">@RuleSentence(row)</MudText>
                            <MudText Typo="Typo.caption" Class="text-secondary">@SupportNotificationLabels.RecipientType(row.RecipientType) recipient</MudText>
                        </MudItem>
                        <MudItem xs="12" md="1">
                            <MudChip T="string" Color="@(row.IsEnabled ? Color.Success : Color.Default)" Variant="Variant.Outlined" Dense="true">
                                @(row.IsEnabled ? "Enabled" : "Disabled")
                            </MudChip>
                        </MudItem>
                        <MudItem xs="12" md="3" Class="d-flex justify-end gap-2">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="() => OpenEditDialogAsync(row)">Edit</MudButton>
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       Color="@(row.IsEnabled ? Color.Warning : Color.Success)"
                                       OnClick="() => ToggleEnabledAsync(row)">
                                @(row.IsEnabled ? "Disable" : "Enable")
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="() => DeleteAsync(row)">Delete</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }
        </MudStack>
    }
</MudPaper>

@code {
    [Parameter] public string? SelectedOrganizationId { get; set; }
    [Parameter] public List<SupportNotificationSubscriptionDto> Rows { get; set; } = new();
    [Parameter] public List<OrganizationDto> Organizations { get; set; } = new();
    [Parameter] public List<SupportGroupDto> SupportGroups { get; set; } = new();
    [Parameter] public List<UserDto> Users { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task OpenCreateDialogAsync()
    {
        var parameters = DialogParameters(null);
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SupportNotificationSubscriptionDialog>("Add Notification Rule", parameters, options);
        var result = await dialog.Result;
        if (result.Canceled || result.Data is not SupportNotificationSubscriptionDialog.SubscriptionFormModel model)
        {
            return;
        }

        try
        {
            await Client.CreateSubscriptionAsync(new CreateSupportNotificationSubscriptionDto
            {
                CustomerOrganizationId = model.CustomerOrganizationId,
                EventType = model.EventType,
                RecipientType = model.RecipientType,
                RecipientId = model.RecipientId,
                Channel = SupportNotificationChannel.Email,
                IsEnabled = model.IsEnabled
            });
            Snackbar.Add("Notification rule created.", Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenEditDialogAsync(SupportNotificationSubscriptionDto row)
    {
        var parameters = DialogParameters(row);
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SupportNotificationSubscriptionDialog>("Edit Notification Rule", parameters, options);
        var result = await dialog.Result;
        if (result.Canceled || result.Data is not SupportNotificationSubscriptionDialog.SubscriptionFormModel model)
        {
            return;
        }

        try
        {
            await Client.UpdateSubscriptionAsync(row.Id, new UpdateSupportNotificationSubscriptionDto
            {
                CustomerOrganizationId = model.CustomerOrganizationId,
                EventType = model.EventType,
                RecipientType = model.RecipientType,
                RecipientId = model.RecipientId,
                Channel = SupportNotificationChannel.Email,
                IsEnabled = model.IsEnabled
            });
            Snackbar.Add("Notification rule saved.", Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ToggleEnabledAsync(SupportNotificationSubscriptionDto row)
    {
        try
        {
            await Client.UpdateSubscriptionAsync(row.Id, new UpdateSupportNotificationSubscriptionDto
            {
                CustomerOrganizationId = row.CustomerOrganizationId,
                EventType = row.EventType,
                RecipientType = row.RecipientType,
                RecipientId = row.RecipientId,
                Channel = row.Channel,
                IsEnabled = !row.IsEnabled
            });
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(SupportNotificationSubscriptionDto row)
    {
        var confirm = await DialogService.ShowMessageBox(
            "Delete Notification Rule",
            $"Delete the rule for {RecipientName(row)}?",
            yesText: "Delete",
            cancelText: "Cancel");
        if (confirm != true)
        {
            return;
        }

        try
        {
            await Client.DeleteSubscriptionAsync(row.Id);
            Snackbar.Add("Notification rule deleted.", Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private DialogParameters DialogParameters(SupportNotificationSubscriptionDto? row) => new()
    {
        ["Subscription"] = row,
        ["CustomerOrganizationId"] = SelectedOrganizationId,
        ["SupportGroups"] = SupportGroups,
        ["Users"] = Users
    };

    private string RuleSentence(SupportNotificationSubscriptionDto row)
        => $"When {SupportNotificationLabels.Event(row.EventType)} occurs, notify {RecipientName(row)} by {SupportNotificationLabels.Channel(row.Channel)}.";

    private string RecipientName(SupportNotificationSubscriptionDto subscription)
        => subscription.RecipientType == SupportNotificationRecipientType.User
            ? Users.FirstOrDefault(x => string.Equals(x.Id, subscription.RecipientId, StringComparison.OrdinalIgnoreCase)) is { } user
                ? DisplayUser(user)
                : subscription.RecipientId
            : SupportGroups.FirstOrDefault(x => string.Equals(x.Id, subscription.RecipientId, StringComparison.OrdinalIgnoreCase))?.Name
              ?? subscription.RecipientId;

    private static string DisplayUser(UserDto user)
        => string.IsNullOrWhiteSpace(user.Name) ? user.Email : $"{user.Name} ({user.Email})";
}
