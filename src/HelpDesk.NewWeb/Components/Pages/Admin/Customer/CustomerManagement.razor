@page "/admin/customers"
@attribute [Authorize(Roles = "HelpdeskAdmin")]
@inject IHttpClientFactory HttpClientFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using Helpdesk.Shared.DTOs.Customer
@using Helpdesk.Shared.DTOs.Organization
@using Helpdesk.Shared.Enums
@using Helpdesk.Shared.Models
@using System.Text.Json

<PageTitle>Customer Management</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h5">Customer Management</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialog">Create</MudButton>
    </MudStack>
    <MudTextField T="string"
                  @bind-Value="searchText"
                  Label="Search customers"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="mb-3"
                  Immediate="true" />
    <MudTable Items="filteredCustomers" Hover="true" Dense="true" T="CustomerDto">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Organization</MudTh>
            <MudTh>State</MudTh>
            <MudTh>Access</MudTh>
            <MudTh class="text-end"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Organization">@context.OrganizationName</MudTd>
            <MudTd DataLabel="State">
                <MudTooltip Text="@context.State.Description()">
                    <MudIconButton Icon="@(context.IsEnabled ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Block)"
                                   Color="@(context.IsEnabled ? Color.Success : Color.Error)"
                                   Size="Size.Small"
                                   aria-label="@($"Customer {context.State.DisplayName()}")" />
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="Access">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudChip T="string"
                             Dense="true"
                             Color="@GetAuthStatusColor(context.AuthStatus?.InviteStatus)"
                             Variant="Variant.Outlined">
                        @(context.AuthStatus?.StatusText ?? "Not invited")
                    </MudChip>
                    <MudTooltip Text="@GetInviteTooltip(context)">
                        <MudIconButton Icon="@GetInviteIcon(context.AuthStatus?.InviteStatus)"
                                       Color="@GetAuthStatusColor(context.AuthStatus?.InviteStatus)"
                                       Size="Size.Small"
                                       Disabled="@IsInviteActionDisabled(context)"
                                       aria-label="@GetInviteActionLabel(context)"
                                       OnClick="() => RunInviteAction(context)" />
                    </MudTooltip>
                </MudStack>
            </MudTd>
            <MudTd Class="text-end">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               aria-label="Edit customer"
                               OnClick="() => OpenEditDialog(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               aria-label="Delete customer"
                               OnClick="() => OpenDeleteDialog(context)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "search")]
    public string? QuerySearch { get; set; }

    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");
    private List<CustomerDto> customers = new();
    private List<OrganizationDto> organizations = new();
    private string searchText = string.Empty;
    private string? appliedQuerySearch;

    private IEnumerable<CustomerDto> filteredCustomers => string.IsNullOrWhiteSpace(searchText)
        ? customers
        : customers.Where(customer =>
            Contains(customer.Name, searchText) ||
            Contains(customer.Email, searchText) ||
            Contains(customer.OrganizationName, searchText));

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override void OnParametersSet()
    {
        if (!string.Equals(appliedQuerySearch, QuerySearch, StringComparison.Ordinal))
        {
            appliedQuerySearch = QuerySearch;
            searchText = QuerySearch ?? string.Empty;
        }
    }

    private async Task LoadData()
    {
        organizations = await HelpdeskApi.GetFromJsonAsync<List<OrganizationDto>>("api/v1/organizations") ?? new();
        var raw = await HelpdeskApi.GetFromJsonAsync<List<CustomerDto>>("api/v1/customers") ?? new();
        foreach (var c in raw)
        {
            c.OrganizationName = organizations.FirstOrDefault(o => o.Id == c.OrganizationId)?.Name ?? string.Empty;
            c.AuthStatus = await HelpdeskApi.GetFromJsonAsync<CustomerAuthStatusDto>($"api/v1/customers/{c.Id}/auth/status");
        }
        customers = raw;
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters { ["Organizations"] = organizations };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CustomerCreateDialog>("Create Customer", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await LoadData();
        }
    }

    private async Task OpenEditDialog(CustomerDto customer)
    {
        var parameters = new DialogParameters
        {
            ["Customer"] = customer,
            ["Organizations"] = organizations
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditCustomerDialog>("Edit Customer", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await LoadData();
        }
    }

    private async Task OpenDeleteDialog(CustomerDto customer)
    {
        var parameters = new DialogParameters { ["Customer"] = customer };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<DeleteCustomerDialog>("Delete Customer", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await LoadData();
        }
    }

    private static bool Contains(string? value, string search) =>
        !string.IsNullOrWhiteSpace(value) && value.Contains(search, StringComparison.OrdinalIgnoreCase);

    private async Task RunInviteAction(CustomerDto customer)
    {
        var status = customer.AuthStatus?.InviteStatus ?? CustomerInviteStatus.NotInvited;
        var route = status switch
        {
            CustomerInviteStatus.Pending or CustomerInviteStatus.Failed or CustomerInviteStatus.Expired => "resend-invite",
            _ => "invite"
        };

        try
        {
            var response = await HelpdeskApi.PostAsync($"api/v1/customers/{customer.Id}/auth/{route}", null);
            if (!response.IsSuccessStatusCode)
            {
                await RefreshAuthStatus(customer);
                Snackbar.Add(await ReadProblemMessageAsync(response), Severity.Error);
                return;
            }

            customer.AuthStatus = await response.Content.ReadFromJsonAsync<CustomerAuthStatusDto>();
            Snackbar.Add(route == "invite" ? "Invite sent." : "Invite resent.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Invite failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task RefreshAuthStatus(CustomerDto customer)
    {
        try
        {
            customer.AuthStatus = await HelpdeskApi.GetFromJsonAsync<CustomerAuthStatusDto>($"api/v1/customers/{customer.Id}/auth/status");
        }
        catch
        {
            // Keep the existing row state if the status refresh also fails.
        }
    }

    private static async Task<string> ReadProblemMessageAsync(HttpResponseMessage response)
    {
        var body = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(body))
        {
            return $"Invite failed ({(int)response.StatusCode}).";
        }

        try
        {
            var problem = JsonSerializer.Deserialize<ProblemResponse>(body, new JsonSerializerOptions(JsonSerializerDefaults.Web));
            return problem?.Detail ?? problem?.Title ?? body;
        }
        catch (JsonException)
        {
            return body;
        }
    }

    private sealed record ProblemResponse(string? Title, string? Detail);

    private static bool IsInviteActionDisabled(CustomerDto customer)
    {
        if (!customer.IsEnabled)
        {
            return true;
        }

        var status = customer.AuthStatus?.InviteStatus ?? CustomerInviteStatus.NotInvited;
        return status is CustomerInviteStatus.Active or CustomerInviteStatus.Disabled;
    }

    private static string GetInviteActionLabel(CustomerDto customer)
    {
        var status = customer.AuthStatus?.InviteStatus ?? CustomerInviteStatus.NotInvited;
        return status switch
        {
            CustomerInviteStatus.Pending => "Resend invite",
            CustomerInviteStatus.Failed => "Retry invite",
            CustomerInviteStatus.Expired => "Resend invite",
            CustomerInviteStatus.Active => "Login active",
            CustomerInviteStatus.Disabled => "Login disabled",
            _ => "Invite"
        };
    }

    private static string GetInviteTooltip(CustomerDto customer) => customer.IsEnabled
        ? GetInviteActionLabel(customer)
        : "Enable the customer before inviting.";

    private static string GetInviteIcon(CustomerInviteStatus? status) => status switch
    {
        CustomerInviteStatus.Pending => Icons.Material.Filled.MarkEmailUnread,
        CustomerInviteStatus.Active => Icons.Material.Filled.VerifiedUser,
        CustomerInviteStatus.Disabled => Icons.Material.Filled.Block,
        CustomerInviteStatus.Failed => Icons.Material.Filled.Error,
        CustomerInviteStatus.Expired => Icons.Material.Filled.Update,
        _ => Icons.Material.Filled.PersonAdd
    };

    private static Color GetAuthStatusColor(CustomerInviteStatus? status) => status switch
    {
        CustomerInviteStatus.Pending => Color.Info,
        CustomerInviteStatus.Active => Color.Success,
        CustomerInviteStatus.Disabled => Color.Error,
        CustomerInviteStatus.Failed => Color.Error,
        CustomerInviteStatus.Expired => Color.Warning,
        _ => Color.Default
    };

}
