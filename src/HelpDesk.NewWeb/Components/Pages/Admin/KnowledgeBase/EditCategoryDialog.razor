@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject IErrorLoggingService ErrorLogger
@using System.ComponentModel.DataAnnotations
@using HelpDesk.NewWeb.Services
@code {
    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public Helpdesk.Shared.DTOs.Category.CategoryDto Category { get; set; } = default!;

    private MudForm form = default!;
    private EditModel model = new();

    protected override void OnInitialized()
    {
        model = new EditModel { Name = Category.Name };
    }

    private async Task Submit()
    {
        await form.Validate();
        if (form.IsValid)
        {
            try
            {
                var response = await HelpdeskApi.PutAsJsonAsync($"api/v1/knowledgebase/categories/{Category.Id}", model);
                if (response.IsSuccessStatusCode)
                {
                    Dialog.Close(DialogResult.Ok(true));
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Error saving category: {error}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add("Unexpected error", Severity.Error);
                await ErrorLogger.LogAsync(ex, nameof(EditCategoryDialog));
            }
        }
    }

    private void Cancel() => Dialog.Cancel();

    public class EditModel
    {
        [Required]
        public string Name { get; set; } = string.Empty;
    }
}

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2 mb-n1" />
            Edit Category
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" Model="model" OnValidSubmit="Submit" Class="mt-2">
            <MudTextField @bind-Value="model.Name" Label="Name" Required="true" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled">Save</MudButton>
    </DialogActions>
</MudDialog>
