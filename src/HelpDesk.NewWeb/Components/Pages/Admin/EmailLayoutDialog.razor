@using FluentValidation
@using Helpdesk.Shared.Models
@using System.Net
@using System.Text.RegularExpressions
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.ViewQuilt" Class="mr-2 mb-n1" />
            @if (model.Id == 0) { <span>Create Email Layout</span> }
            else { <span>Edit Email Layout</span> }
        </MudText>
    </TitleContent>
    <DialogContent>
        <div style="min-height: 500px;">
            <MudForm @ref="form" Model="model" @bind-IsValid="isValid" Validation="ValidateLayout">
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudTextField @bind-Value="model.Name" For="@(() => model.Name)"
                                      Label="Layout Name"
                                      Disabled="@(model.Id != 0 && model.IsSystem)" />
                    </MudItem>
                    <MudItem xs="12">
                        <EmailHtmlEditor Value="@model.HtmlContent"
                                         ValueChanged="@OnHtmlValueChanged"
                                         IsLayoutEditor="true"
                                         Placeholders="@layoutPlaceholders"
                                         PreviewTitle="Layout Preview" />
                    </MudItem>
                </MudGrid>
            </MudForm>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="OpenPreview">Preview</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!isValid)">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public EmailLayout Model { get; set; } = new();

    private MudForm form = default!;
    private bool isValid;
    private EmailLayout model = new();
    private static readonly string[] layoutPlaceholders =
    [
        "{{{BODY}}}",
        "{{BRAND_NAME}}",
        "{{{LOGO_HTML}}}",
        "{{{FOOTER_HTML}}}",
        "{{PRIMARY_COLOR}}"
    ];

    private LayoutValidator _layoutValidator = new();

    public class LayoutValidator : AbstractValidator<EmailLayout>
    {
        public LayoutValidator()
        {
            RuleFor(x => x.Name).NotEmpty().WithMessage("Layout Name is required.");
            RuleFor(x => x.HtmlContent).NotEmpty().WithMessage("Layout HTML cannot be empty.");
            RuleFor(x => x.HtmlContent).Must(x => (x ?? string.Empty).Contains("{{{BODY}}}", StringComparison.Ordinal))
                .WithMessage("Layout must contain {{{BODY}}} placeholder.");
        }
    }

    protected override void OnInitialized()
    {
        model = new EmailLayout
        {
            Id = Model.Id,
            Name = Model.Name,
            HtmlContent = Model.HtmlContent,
            IsSystem = Model.IsSystem,
            TenantId = Model.TenantId,
            Version = Model.Version
        };
    }

    private IEnumerable<string> ValidateLayout(EmailLayout m)
    {
        var result = _layoutValidator.Validate(m);
        return result.IsValid ? Enumerable.Empty<string>() : result.Errors.Select(e => e.ErrorMessage);
    }

    private async Task OnHtmlValueChanged(string newHtmlContent)
    {
        model.HtmlContent = newHtmlContent;
        await form.Validate();
    }

    private async Task Submit()
    {
        await form.Validate();
        if (!isValid) return;

        HttpResponseMessage response;
        if (model.Id == 0)
        {
            response = await HelpdeskApi.PostAsJsonAsync("api/v1/email-layouts", model);
        }
        else
        {
            response = await HelpdeskApi.PutAsJsonAsync($"api/v1/email-layouts/{model.Id}", model);
        }

        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("Layout saved successfully!", MudBlazor.Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add("Error saving layout.", MudBlazor.Severity.Error);
        }
    }

    private async Task OpenPreview()
    {
        var rendered = RenderPreviewLayout(model.HtmlContent ?? string.Empty);
        var parameters = new DialogParameters<EmailTemplatePreviewDialog>
        {
            { x => x.RenderedHtml, rendered }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<EmailTemplatePreviewDialog>("Layout Preview", parameters, options);
    }

    private static string RenderPreviewLayout(string layoutHtml)
    {
        var regex = new Regex("\\{\\{\\{?(?<key>[A-Z_]+)\\}?\\}\\}", RegexOptions.Compiled);
        return regex.Replace(layoutHtml, match =>
        {
            var key = match.Groups["key"].Value;
            return key switch
            {
                "BODY" => "<p>Example body content with <strong>formatting</strong>.</p>",
                "BRAND_NAME" => WebUtility.HtmlEncode("RatelDesk"),
                "PRIMARY_COLOR" => WebUtility.HtmlEncode("#0b5fff"),
                "LOGO_HTML" => "<div style=\"font-size:12px;\">[Logo]</div>",
                "FOOTER_HTML" => "<p>Sample footer text</p>",
                _ => match.Value
            };
        });
    }

    private void Cancel() => Dialog.Cancel();
}
