@code {
    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");
@inject IHttpClientFactory HttpClientFactory
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public Helpdesk.Shared.DTOs.Role.RoleDto Role { get; set; } = default!;

    private async Task Delete()
    {
        var response = await HelpdeskApi.DeleteAsync($"api/v1/roles/{Role.Id}");
        if (response.IsSuccessStatusCode)
        {
            Dialog.Close(DialogResult.Ok(true));
        }
    }

    private void Cancel() => Dialog.Cancel();
}

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">Are you sure you want to delete @Role.Name?</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton OnClick="Delete" Color="Color.Error" Variant="Variant.Filled">Delete</MudButton>
    </DialogActions>
</MudDialog>
