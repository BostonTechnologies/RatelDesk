@page "/admin/roles"
@attribute [Authorize(Roles = "HelpdeskAdmin")]
@inject IHttpClientFactory HttpClientFactory
@inject IDialogService DialogService
@using Helpdesk.Shared.DTOs.Role

<PageTitle>Role Management</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h5">Role Management</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialog">Create</MudButton>
    </MudStack>
    <MudSimpleTable Dense="true">
        <thead>
            <tr>
                <th>Name</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in roles)
            {
                <tr>
                    <td>@role.Name</td>
                    <td>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="() => OpenEditDialog(role)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => OpenDeleteDialog(role)" />
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>

@code {
    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");
    private List<RoleDto> roles = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadRoles();
    }

    private async Task LoadRoles()
    {
        roles = await HelpdeskApi.GetFromJsonAsync<List<RoleDto>>("api/v1/roles") ?? new();
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateRoleDialog>("Create Role", options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await LoadRoles();
        }
    }

    private async Task OpenEditDialog(RoleDto role)
    {
        var parameters = new DialogParameters { ["Role"] = role };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditRoleDialog>("Edit Role", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await LoadRoles();
        }
    }

    private async Task OpenDeleteDialog(RoleDto role)
    {
        var parameters = new DialogParameters { ["Role"] = role };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<DeleteRoleDialog>("Delete Role", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await LoadRoles();
        }
    }

}
