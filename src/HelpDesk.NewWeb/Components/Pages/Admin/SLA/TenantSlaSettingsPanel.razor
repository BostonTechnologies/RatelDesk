@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@using Helpdesk.Shared.DTOs.Organization
@using Helpdesk.Shared.DTOs.Sla
@using Helpdesk.Shared.Enums

<MudPaper Class="pa-3">
    <MudGrid Spacing="2" AlignItems="Center">
        <MudItem xs="12" md="2">
            <MudText Typo="Typo.subtitle2">Tenant SLA Settings</MudText>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="string"
                       Label="Tenant"
                       Value="TenantId"
                       ValueChanged="OnTenantChanged"
                       Required="true"
                       Dense="true"
                       Margin="Margin.Dense">
                @foreach (var tenant in Tenants)
                {
                    <MudSelectItem T="string" Value="@tenant.Id">@tenant.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="1" Class="d-flex justify-center">
            <MudTooltip Text="@BusinessHoursTooltip">
                <MudIconButton Icon="@(model?.UseBusinessHours == true ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                               Color="@(model?.UseBusinessHours == true ? Color.Success : Color.Default)"
                               Size="Size.Medium"
                               Disabled="@(model is null || string.IsNullOrWhiteSpace(TenantId) || saving)"
                               aria-label="@BusinessHoursTooltip"
                               OnClick="ToggleBusinessHoursAsync" />
            </MudTooltip>
        </MudItem>
        <MudItem xs="12" md="6">
            @if (model is null)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else
            {
                <MudSelect T="string"
                           Label="Calendar (optional)"
                           Value="model.CalendarId"
                           ValueChanged="OnCalendarChanged"
                           Clearable="true"
                           Dense="true"
                           Margin="Margin.Dense"
                           Disabled="@(string.IsNullOrWhiteSpace(TenantId) || saving)">
                    @foreach (var calendar in FilteredCalendars)
                    {
                        <MudSelectItem T="string" Value="@calendar.Id">@calendar.Name (@calendar.TimeZoneId)</MudSelectItem>
                    }
                </MudSelect>
            }
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    [Parameter] public string? TenantId { get; set; }
    [Parameter] public EventCallback<string?> TenantIdChanged { get; set; }
    [Parameter] public List<TenantLookupDto> Tenants { get; set; } = new();
    [Parameter] public List<WorkingCalendarDto> Calendars { get; set; } = new();

    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");
    private TenantSlaSettingsDto? model;
    private TenantSlaSettingsDto? lastSaved;
    private string? loadedTenantId;
    private bool saving;
    private string BusinessHoursTooltip => model?.UseBusinessHours == true
        ? "Disable business hours"
        : "Enable business hours";
    private IEnumerable<WorkingCalendarDto> FilteredCalendars => Calendars
        .Where(x => x.ScopeType == CalendarScopeType.SystemDefault || string.Equals(x.TenantId, TenantId, StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => x.ScopeType)
        .ThenBy(x => x.Name);

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(loadedTenantId, TenantId, StringComparison.Ordinal))
        {
            return;
        }

        loadedTenantId = TenantId;
        model = null;
        lastSaved = null;
        await LoadAsync();
    }

    private async Task OnTenantChanged(string? value)
    {
        await TenantIdChanged.InvokeAsync(value);
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(TenantId))
        {
            return;
        }

        model = await HelpdeskApi.GetFromJsonAsync<TenantSlaSettingsDto>($"api/v1/tenant-sla-settings/{Uri.EscapeDataString(TenantId)}");
        lastSaved = Clone(model);
    }

    private async Task ToggleBusinessHoursAsync()
    {
        if (model is null)
        {
            return;
        }

        model.UseBusinessHours = !model.UseBusinessHours;
        await SaveAsync();
    }

    private async Task OnCalendarChanged(string? calendarId)
    {
        if (model is null)
        {
            return;
        }

        model.CalendarId = string.IsNullOrWhiteSpace(calendarId) ? null : calendarId;
        await SaveAsync();
    }

    private async Task SaveAsync()
    {
        if (model is null || string.IsNullOrWhiteSpace(TenantId))
        {
            Snackbar.Add("Please select a tenant first.", Severity.Warning);
            return;
        }

        saving = true;
        model.TenantId = TenantId.Trim();
        var response = await HelpdeskApi.PutAsJsonAsync($"api/v1/tenant-sla-settings/{Uri.EscapeDataString(TenantId)}", model);
        saving = false;
        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            Snackbar.Add($"Failed to save: {error}", Severity.Error);
            model = Clone(lastSaved);
            return;
        }

        lastSaved = Clone(model);
        Snackbar.Add("Tenant SLA settings saved.", Severity.Success);
    }

    private static TenantSlaSettingsDto? Clone(TenantSlaSettingsDto? source)
    {
        return source is null
            ? null
            : new TenantSlaSettingsDto
            {
                TenantId = source.TenantId,
                UseBusinessHours = source.UseBusinessHours,
                CalendarId = source.CalendarId
            };
    }
}
