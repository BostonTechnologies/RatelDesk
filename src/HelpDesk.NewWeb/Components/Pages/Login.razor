@inject HelpDesk.NewWeb.Models.WebAuthenticationMode AuthenticationMode
@page "/login"
@attribute [AllowAnonymous]

@inject NavigationManager Navigation
@inject IWebHostEnvironment Env
@inject IConfiguration Config
@inject AuthenticationStateProvider AuthStateProvider
@inject IHttpClientFactory HttpClientFactory
@using System.Net.Http.Json

<PageTitle>@_branding.ApplicationName</PageTitle>
<HeadContent><link rel="icon" href="@_branding.FaviconUrl" /></HeadContent>

<section class="helpdesk-login-page">
    <MudPaper Elevation="2" Class="helpdesk-login-panel">
        <MudStack AlignItems="AlignItems.Center" Spacing="1" Class="helpdesk-login-header">
            <img class="helpdesk-login-logo" src="@_branding.CompactLogoUrl" alt="@_branding.ApplicationName" />
            <MudText Typo="Typo.overline" HtmlTag="p" Class="helpdesk-login-product">Service management</MudText>
            <MudText Typo="Typo.h4" HtmlTag="h1" Class="helpdesk-login-title">@_branding.ApplicationName</MudText>
            <MudText Typo="Typo.body2" HtmlTag="p" Class="helpdesk-login-environment">@EnvironmentLabel</MudText>
        </MudStack>

        <MudStack Spacing="2" Class="helpdesk-login-actions">
            <MudText Typo="Typo.body1" Align="Align.Center" Class="helpdesk-login-copy">
                Continue to @_branding.ApplicationName using your authorised account.
            </MudText>

            @if (SupportsLocalAccounts)
            {
                @if (SignInError is not null)
                {
                    <MudAlert Severity="Severity.Error" data-testid="local-login-error">@SignInError</MudAlert>
                }
                <form method="post" action="/local-login" class="helpdesk-login-local-form" data-testid="local-login-form" data-interactive="@(RendererInfo.IsInteractive ? "true" : "false")">
                    <AntiforgeryToken />
                    <MudTextField T="string" Name="email" Disabled="@(!RendererInfo.IsInteractive)" Label="Email" InputType="InputType.Email" Required="true" Variant="Variant.Outlined" FullWidth="true" />
                    <MudTextField T="string" Name="password" Disabled="@(!RendererInfo.IsInteractive)" Label="Password" InputType="InputType.Password" Required="true" Variant="Variant.Outlined" FullWidth="true" Class="mt-3" />
                    <MudTextField T="string" Name="twoFactorCode" Disabled="@(!RendererInfo.IsInteractive)" Label="Authenticator or recovery code" InputType="InputType.Password" Variant="Variant.Outlined" FullWidth="true" Class="mt-3" HelperText="Required only if two-factor authentication is enabled." />
                    <MudCheckBox T="bool" Name="rememberMe" Disabled="@(!RendererInfo.IsInteractive)" Label="Keep me signed in" Color="Color.Primary" Class="mt-2" />
                    <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="@(!RendererInfo.IsInteractive)" Size="Size.Large" Color="Color.Primary" FullWidth="true" Class="mt-3" StartIcon="@Icons.Material.Filled.Login">
                        Sign in to @_branding.ApplicationName
                    </MudButton>
                </form>
                <MudLink Href="/activate" Class="align-self-center">Activate or reset your local account</MudLink>
            }

            @if (SupportsLocalAccounts && SupportsOidc)
            {
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.body2" Align="Align.Center">or use your organization sign-in</MudText>
            }

            @if (SupportsOidc)
            {
                <MudButton Variant="Variant.Filled"
                           Size="Size.Large"
                           Color="Color.Primary"
                           FullWidth="true"
                           Class="helpdesk-login-primary-action"
                           StartIcon="@Icons.Material.Filled.Login"
                           Href="/login-authentik">
                    Sign in to @_branding.ApplicationName
                </MudButton>
            }

            @if (Env.IsDevelopment())
            {
                <MudDivider Class="my-1" />
                <MudText Typo="Typo.body2" Align="Align.Center" Class="helpdesk-login-dev-copy">
                    Local development access is enabled for runtime investigations.
                </MudText>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           FullWidth="true"
                           Class="helpdesk-login-dev-action"
                           Href="/auth/development">
                    Sign in as local operator
                </MudButton>
            }
        </MudStack>
    </MudPaper>
</section>

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string? SignInStatus { get; set; }

    private string? SignInError => SignInStatus switch
    {
        "Email and password are required" => "Enter your email and passphrase to sign in.",
        "Too many sign-in attempts. Please retry shortly." => "Too many sign-in attempts. Please retry shortly.",
        "Sign-in failed" => "Sign-in failed. Check your email, passphrase and authenticator or recovery code.",
        _ => null
    };

    private BrandingSnapshot _branding = new();
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _branding = await HttpClientFactory.CreateClient("HelpdeskApi")
                .GetFromJsonAsync<BrandingSnapshot>("api/v1/branding") ?? _branding;
        }
        catch (HttpRequestException exception)
        {
            System.Diagnostics.Debug.WriteLine($"Branding endpoint unavailable while rendering login: {exception.Message}");
        }
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
            return;

        Navigation.NavigateTo("/home", replace: true);
    }

    private string EnvironmentLabel =>
        Config["LoginUi:EnvironmentLabel"]?.Trim() is { Length: > 0 } label
            ? label
            : "Production system";

    private bool SupportsLocalAccounts => AuthenticationMode.SupportsLocalAccounts;
    private bool SupportsOidc => AuthenticationMode.UsesOidc;

    private sealed class BrandingSnapshot
    {
        public string ApplicationName { get; set; } = "RatelDesk";
        public string CompactLogoUrl { get; set; } = "/branding/rateldesk-mark.webp";
        public string FaviconUrl { get; set; } = "/favicon.ico";
    }
}
