@page "/login"
@attribute [AllowAnonymous]

@inject NavigationManager Navigation
@inject IWebHostEnvironment Env
@inject IConfiguration Config
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>RatelDesk</PageTitle>

<section class="helpdesk-login-page">
    <MudPaper Elevation="2" Class="helpdesk-login-panel">
        <MudStack AlignItems="AlignItems.Center" Spacing="1" Class="helpdesk-login-header">
            <img class="helpdesk-login-logo" src="rateldesk-mark.svg" alt="RatelDesk" />
            <MudText Typo="Typo.overline" HtmlTag="p" Class="helpdesk-login-product">Service management</MudText>
            <MudText Typo="Typo.h4" HtmlTag="h1" Class="helpdesk-login-title">RatelDesk</MudText>
            <MudText Typo="Typo.body2" HtmlTag="p" Class="helpdesk-login-environment">@EnvironmentLabel</MudText>
        </MudStack>

        <MudStack Spacing="2" Class="helpdesk-login-actions">
            <MudText Typo="Typo.body1" Align="Align.Center" Class="helpdesk-login-copy">
                Continue to RatelDesk using your authorised account.
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       Color="Color.Primary"
                       FullWidth="true"
                       Class="helpdesk-login-primary-action"
                       StartIcon="@Icons.Material.Filled.Login"
                       Href="/login-authentik">
                Sign in to Helpdesk
            </MudButton>

            @if (Env.IsDevelopment())
            {
                <MudDivider Class="my-1" />
                <MudText Typo="Typo.body2" Align="Align.Center" Class="helpdesk-login-dev-copy">
                    Local development access is enabled for runtime investigations.
                </MudText>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           FullWidth="true"
                           Class="helpdesk-login-dev-action"
                           Href="/auth/development">
                    Sign in as local operator
                </MudButton>
            }
        </MudStack>
    </MudPaper>
</section>

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
            return;

        Navigation.NavigateTo("/home", replace: true);
    }

    private string EnvironmentLabel =>
        Config["LoginUi:EnvironmentLabel"]?.Trim() is { Length: > 0 } label
            ? label
            : "Production system";

}
