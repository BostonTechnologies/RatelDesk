@page "/login"
@attribute [AllowAnonymous]

@inject NavigationManager Navigation
@inject IWebHostEnvironment Env
@inject IConfiguration Config
@inject AuthenticationStateProvider AuthStateProvider
@inject IHttpClientFactory HttpClientFactory
@using System.Net.Http.Json

<PageTitle>@_branding.ApplicationName</PageTitle>
<HeadContent><link rel="icon" href="@_branding.FaviconUrl" /></HeadContent>

<section class="helpdesk-login-page">
    <MudPaper Elevation="2" Class="helpdesk-login-panel">
        <MudStack AlignItems="AlignItems.Center" Spacing="1" Class="helpdesk-login-header">
            <img class="helpdesk-login-logo" src="@_branding.CompactLogoUrl" alt="@_branding.ApplicationName" />
            <MudText Typo="Typo.overline" HtmlTag="p" Class="helpdesk-login-product">Service management</MudText>
            <MudText Typo="Typo.h4" HtmlTag="h1" Class="helpdesk-login-title">@_branding.ApplicationName</MudText>
            <MudText Typo="Typo.body2" HtmlTag="p" Class="helpdesk-login-environment">@EnvironmentLabel</MudText>
        </MudStack>

        <MudStack Spacing="2" Class="helpdesk-login-actions">
            <MudText Typo="Typo.body1" Align="Align.Center" Class="helpdesk-login-copy">
                Continue to @_branding.ApplicationName using your authorised account.
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       Color="Color.Primary"
                       FullWidth="true"
                       Class="helpdesk-login-primary-action"
                       StartIcon="@Icons.Material.Filled.Login"
                       Href="/login-authentik">
                Sign in to @_branding.ApplicationName
            </MudButton>

            @if (Env.IsDevelopment())
            {
                <MudDivider Class="my-1" />
                <MudText Typo="Typo.body2" Align="Align.Center" Class="helpdesk-login-dev-copy">
                    Local development access is enabled for runtime investigations.
                </MudText>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           FullWidth="true"
                           Class="helpdesk-login-dev-action"
                           Href="/auth/development">
                    Sign in as local operator
                </MudButton>
            }
        </MudStack>
    </MudPaper>
</section>

@code {
    private BrandingSnapshot _branding = new();
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _branding = await HttpClientFactory.CreateClient("HelpdeskApi")
                .GetFromJsonAsync<BrandingSnapshot>("api/v1/branding") ?? _branding;
        }
        catch (HttpRequestException exception)
        {
            System.Diagnostics.Debug.WriteLine($"Branding endpoint unavailable while rendering login: {exception.Message}");
        }
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
            return;

        Navigation.NavigateTo("/home", replace: true);
    }

    private string EnvironmentLabel =>
        Config["LoginUi:EnvironmentLabel"]?.Trim() is { Length: > 0 } label
            ? label
            : "Production system";

    private sealed class BrandingSnapshot
    {
        public string ApplicationName { get; set; } = "RatelDesk";
        public string CompactLogoUrl { get; set; } = "/branding/rateldesk-mark.svg";
        public string FaviconUrl { get; set; } = "/favicon.ico";
    }
}
