@page "/ops/workflows"
@attribute [Authorize(Roles = "Request.Read,Request.Write,Request.Execute,Request.Manager,HelpdeskAdmin")]

@using System.Net.Http.Json
@using System.Security.Claims
@using Helpdesk.Shared.DTOs
@using Helpdesk.Shared.DTOs.Orchestration
@using Helpdesk.Shared.DTOs.Request
@using Helpdesk.Shared.Models
@using Microsoft.AspNetCore.Components.Authorization

@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar

<PageTitle>Workflow Ops Dashboard</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5">Workflow Operations</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@loading" OnClick="LoadAllAsync">Refresh</MudButton>
        </MudStack>

        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.caption">Overdue Tasks</MudText>
                    <MudText Typo="Typo.h5">@overdue.TotalCount</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.caption">Escalated Tasks</MudText>
                    <MudText Typo="Typo.h5">@escalated.TotalCount</MudText>
                </MudPaper>
            </MudItem>
            @if (isAdmin)
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Class="pa-3">
                        <MudText Typo="Typo.caption">Retries Pending</MudText>
                        <MudText Typo="Typo.h5">@retriesPending.TotalCount</MudText>
                    </MudPaper>
                </MudItem>
            }
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.caption">Critical Failures (24h)</MudText>
                    <MudText Typo="Typo.h5">@criticalFailures.TotalCount</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.caption">External orchestration Callback Rejections (7d)</MudText>
                    <MudText Typo="Typo.h5">@callbackRejections.TotalCount</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.caption">Binding Issues</MudText>
                    <MudText Typo="Typo.h5">@bindingIssues.TotalCount</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Class="pa-3">
            <MudText Typo="Typo.h6" Class="mb-2">Overdue</MudText>
            <MudTable T="TaskOpsRowDto" Items="overdue.Items" Dense="true" Hover="true" Loading="@loading">
                <HeaderContent>
                    <MudTh>Request</MudTh>
                    <MudTh>Task</MudTh>
                    <MudTh>Assignee</MudTh>
                    <MudTh>Due At</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.RequestTrackingId</MudTd>
                    <MudTd>@context.TaskName</MudTd>
                    <MudTd>@(context.AssignedToDisplayName ?? context.AssignedToId ?? "-")</MudTd>
                    <MudTd>@context.DueAt?.LocalDateTime.ToString("g")</MudTd>
                    <MudTd>@context.Status</MudTd>
                    <MudTd><MudButton Variant="Variant.Text" Href="@($"/requests/{context.RequestId}")">Open</MudButton></MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        <MudPaper Class="pa-3">
            <MudText Typo="Typo.h6" Class="mb-2">Escalated</MudText>
            <MudTable T="TaskOpsRowDto" Items="escalated.Items" Dense="true" Hover="true" Loading="@loading">
                <HeaderContent>
                    <MudTh>Request</MudTh>
                    <MudTh>Task</MudTh>
                    <MudTh>Assignee</MudTh>
                    <MudTh>Due At</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.RequestTrackingId</MudTd>
                    <MudTd>@context.TaskName</MudTd>
                    <MudTd>@(context.AssignedToDisplayName ?? context.AssignedToId ?? "-")</MudTd>
                    <MudTd>@context.DueAt?.LocalDateTime.ToString("g")</MudTd>
                    <MudTd>@context.Status</MudTd>
                    <MudTd><MudButton Variant="Variant.Text" Href="@($"/requests/{context.RequestId}")">Open</MudButton></MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        @if (isAdmin)
        {
            <MudPaper Class="pa-3">
                <MudText Typo="Typo.h6" Class="mb-2">Retries Pending</MudText>
                <MudTable T="TaskOpsRowDto" Items="retriesPending.Items" Dense="true" Hover="true" Loading="@loading">
                    <HeaderContent>
                        <MudTh>Request</MudTh>
                        <MudTh>Task</MudTh>
                        <MudTh>Next Retry</MudTh>
                        <MudTh>Retry Count</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.RequestTrackingId</MudTd>
                        <MudTd>@context.TaskName</MudTd>
                        <MudTd>@context.NextRetryAt?.LocalDateTime.ToString("g")</MudTd>
                        <MudTd>@context.RetryCount</MudTd>
                        <MudTd>@context.Status</MudTd>
                        <MudTd>
                            <MudStack Row="true" Spacing="1">
                                <MudButton Variant="Variant.Text" Href="@($"/requests/{context.RequestId}")">Open</MudButton>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(async () => await RetryNowAsync(context.TaskId))">Retry now</MudButton>
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }

        <MudPaper Class="pa-3">
            <MudText Typo="Typo.h6" Class="mb-2">Critical Failures (24h)</MudText>
            <MudTable T="TaskOpsRowDto" Items="criticalFailures.Items" Dense="true" Hover="true" Loading="@loading">
                <HeaderContent>
                    <MudTh>Request</MudTh>
                    <MudTh>Task</MudTh>
                    <MudTh>Failure Policy</MudTh>
                    <MudTh>Reason</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.RequestTrackingId</MudTd>
                    <MudTd>@context.TaskName</MudTd>
                    <MudTd>@context.FailurePolicy</MudTd>
                    <MudTd>@context.FailureReason</MudTd>
                    <MudTd>@context.Status</MudTd>
                    <MudTd><MudButton Variant="Variant.Text" Href="@($"/requests/{context.RequestId}")">Open</MudButton></MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        <MudPaper Class="pa-3">
            <MudText Typo="Typo.h6" Class="mb-2">External orchestration Callback Rejections (7d)</MudText>
            <MudTable T="OrchestrationCallbackRejectionOpsDto" Items="callbackRejections.Items" Dense="true" Hover="true" Loading="@loading">
                <HeaderContent>
                    <MudTh>When</MudTh>
                    <MudTh>Reason</MudTh>
                    <MudTh>Caller</MudTh>
                    <MudTh>Correlation</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.CreatedUtc.ToLocalTime().ToString("g")</MudTd>
                    <MudTd>@context.ReasonCode</MudTd>
                    <MudTd>@(context.CallerClientId ?? "-")</MudTd>
                    <MudTd>@(context.CorrelationId ?? "-")</MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Text" Href="@BuildNotificationsLink(context.CorrelationId)">Notifications</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        <MudPaper Class="pa-3">
            <MudText Typo="Typo.h6" Class="mb-2">Binding Issues</MudText>
            <MudTable T="AutomationBindingIssueOpsDto" Items="bindingIssues.Items" Dense="true" Hover="true" Loading="@loading">
                <HeaderContent>
                    <MudTh>Service</MudTh>
                    <MudTh>Request Form</MudTh>
                    <MudTh>Task</MudTh>
                    <MudTh>State</MudTh>
                    <MudTh>External orchestration Target</MudTh>
                    <MudTh>Last Sync</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@(context.ServiceName ?? context.ServiceId)</MudTd>
                    <MudTd>@context.RequestFormTitle</MudTd>
                    <MudTd>@(context.TaskName ?? context.TaskTemplateId.ToString())</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@GetBindingIssueColor(context)">
                            @(context.Enabled ? context.SyncState.ToString() : "Disabled")
                        </MudChip>
                    </MudTd>
                    <MudTd>@(context.OrchestrationRequestDefinitionName ?? context.OrchestrationRequestDefinitionId)</MudTd>
                    <MudTd>@context.LastSyncedAtUtc?.LocalDateTime.ToString("g")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudStack>
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");

    private bool loading;
    private bool isAdmin;
    private PagedResponse<TaskOpsRowDto> overdue = new();
    private PagedResponse<TaskOpsRowDto> escalated = new();
    private PagedResponse<TaskOpsRowDto> retriesPending = new();
    private PagedResponse<TaskOpsRowDto> criticalFailures = new();
    private PagedResponse<OrchestrationCallbackRejectionOpsDto> callbackRejections = new();
    private PagedResponse<AutomationBindingIssueOpsDto> bindingIssues = new();

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            isAdmin = user.IsInRole("HelpdeskAdmin")
                || user.Claims.Any(c =>
                    (c.Type == ClaimTypes.Role || c.Type == "roles")
                    && string.Equals(c.Value, "HelpdeskAdmin", StringComparison.OrdinalIgnoreCase));
        }

        await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        loading = true;
        try
        {
            var overdueTask = LoadPagedOrEmptyAsync<TaskOpsRowDto>("api/v1/ops/tasks/overdue?page=1&pageSize=25", "Overdue tasks");
            var escalatedTask = LoadPagedOrEmptyAsync<TaskOpsRowDto>("api/v1/ops/tasks/escalated?page=1&pageSize=25", "Escalated tasks");
            var criticalTask = LoadPagedOrEmptyAsync<TaskOpsRowDto>(
                $"api/v1/ops/tasks/critical-failures?sinceUtc={Uri.EscapeDataString(DateTimeOffset.UtcNow.AddDays(-1).ToString("O"))}&page=1&pageSize=25",
                "Critical failures");
            var callbackRejectionsTask = LoadPagedOrEmptyAsync<OrchestrationCallbackRejectionOpsDto>(
                "api/v1/ops/tasks/orchestration/callback-rejections?page=1&pageSize=25&lookbackDays=7",
                "Callback rejections");
            var bindingIssuesTask = LoadPagedOrEmptyAsync<AutomationBindingIssueOpsDto>(
                "api/v1/ops/tasks/orchestration/binding-issues?page=1&pageSize=25",
                "Binding issues");

            var retriesTask = isAdmin
                ? LoadPagedOrEmptyAsync<TaskOpsRowDto>("api/v1/ops/tasks/retries-pending?page=1&pageSize=25", "Retries pending")
                : Task.FromResult(new PagedResponse<TaskOpsRowDto>());

            await Task.WhenAll(overdueTask, escalatedTask, retriesTask, criticalTask, callbackRejectionsTask, bindingIssuesTask);

            overdue = await overdueTask;
            escalated = await escalatedTask;
            retriesPending = await retriesTask;
            criticalFailures = await criticalTask;
            callbackRejections = await callbackRejectionsTask;
            bindingIssues = await bindingIssuesTask;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task<PagedResponse<T>> LoadPagedOrEmptyAsync<T>(string url, string label)
    {
        try
        {
            return await HelpdeskApi.GetFromJsonAsync<PagedResponse<T>>(url) ?? new PagedResponse<T>();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.StatusCode is null
                ? $"{label} could not be loaded right now."
                : $"{label} could not be loaded right now ({(int)ex.StatusCode}).", Severity.Warning);
        }
        catch
        {
            Snackbar.Add($"{label} could not be loaded right now.", Severity.Warning);
        }

        return new PagedResponse<T>();
    }

    private async Task RetryNowAsync(string taskId)
    {
        try
        {
            var response = await HelpdeskApi.PostAsJsonAsync($"api/v1/request-tasks/{taskId}/retry", new { });
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add(string.IsNullOrWhiteSpace(error) ? "Retry failed." : error, Severity.Error);
                return;
            }

            Snackbar.Add("Retry requested.", Severity.Success);
            await LoadAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Retry failed: {ex.Message}", Severity.Error);
        }
    }

    private static string BuildNotificationsLink(string? correlationId)
        => string.IsNullOrWhiteSpace(correlationId)
            ? "/notifications?category=DomainEvent.Orchestration"
            : $"/notifications?category=DomainEvent.Orchestration&correlationId={Uri.EscapeDataString(correlationId)}";

    private static Color GetBindingIssueColor(AutomationBindingIssueOpsDto binding)
    {
        if (!binding.Enabled)
        {
            return Color.Default;
        }

        return binding.SyncState switch
        {
            AutomationBindingSyncState.Broken => Color.Error,
            AutomationBindingSyncState.ImportPending => Color.Warning,
            AutomationBindingSyncState.Drifted => Color.Info,
            _ => Color.Success
        };
    }
}
