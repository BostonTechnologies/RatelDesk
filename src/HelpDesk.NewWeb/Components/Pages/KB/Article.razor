@page "/kb/{Id}"
@attribute [Authorize(Roles = "HelpdeskAdmin")]
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

@using System.Text.RegularExpressions
@using Helpdesk.Shared.DTOs.Article
@using Helpdesk.Shared.DTOs.Orchestration
@using Helpdesk.Shared.Models

<PageTitle>@(article?.Title ?? "Article")</PageTitle>

@if (loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (article == null)
{
    <MudAlert Severity="Severity.Error">Could not load the article.</MudAlert>
}
else
{
    <MudGrid>
        <!-- LEFT COLUMN: Title, Info, and Content -->
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4" Height="100%">
                <!-- Title -->
                <MudText Typo="Typo.h4" GutterBottom="true">@article.Title</MudText>

                <!-- Info Chips (Compact) -->
                <MudStack Row="true" Spacing="2" Class="mb-4">
                    @if (!string.IsNullOrWhiteSpace(article.LinkedTicketId))
                    {
                        <MudChip T="string" Icon="@Icons.Material.Filled.Link" Color="Color.Primary" Href="@($"/incidents/{article.LinkedTicketId}")" Target="_blank">Linked Ticket</MudChip>
                    }
                    <MudChip T="string" Icon="@Icons.Material.Filled.Dns" Color="@(articleStats?.ChunkCount > 0 ? Color.Success : Color.Warning)">@(articleStats?.ChunkCount > 0 ? $"Indexed Chunks ({articleStats.ChunkCount})" : "Not Indexed")</MudChip>
                    <MudChip T="string" Icon="@Icons.Material.Filled.Category" Color="Color.Info">@article.CategoryId</MudChip>
                    <MudChip T="string" Icon="@Icons.Material.Filled.CalendarToday" Color="Color.Default">Created: @article.CreatedAt.ToLocalTime().ToString("g")</MudChip>
                    @if (articleStats?.LastIndexedAt is not null)
                    {
                        <MudChip T="string" Icon="@Icons.Material.Filled.Schedule" Color="Color.Default">Indexed: @articleStats.LastIndexedAt.Value.ToLocalTime().ToString("g")</MudChip>
                    }
                </MudStack>
                <MudDivider Class="mb-4" />

                <!-- Compact Article Body -->
                <div class="article-body">
                    @foreach (var contentSection in parsedContent)
                    {
                        <MudGrid Class="mb-3">
                            <MudItem xs="12" sm="3">
                                <MudText><strong>@contentSection.Key</strong></MudText>
                            </MudItem>
                            <MudItem xs="12" sm="9">
                                @if (contentSection.Value.listItems.Any())
                                {
                                    <MudList T="string" Clickable="false" Dense="true">
                                        @foreach (var item in contentSection.Value.listItems)
                                        {
                                            <MudListItem T="string" Icon="@Icons.Material.Filled.ChevronRight">
                                                @item
                                            </MudListItem>
                                        }
                                    </MudList>
                                }
                                else
                                {
                                    <MudText>@contentSection.Value.content</MudText>
                                }
                            </MudItem>
                        </MudGrid>
                    }
                </div>

                <!-- Disclaimer -->
                @if (parsedContent.ContainsKey("Disclaimer"))
                {
                    <MudAlert Severity="Severity.Info" Class="mt-6">
                        @parsedContent["Disclaimer"].content
                    </MudAlert>
                }
            </MudPaper>
        </MudItem>

        <!-- RIGHT COLUMN: Admin Actions -->
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Height="100%">
                <MudText Typo="Typo.h6" GutterBottom="true">Admin Actions</MudText>
                <MudStack Spacing="2">
                    @if (articleAuditEntries.Count > 0)
                    {
                        <MudPaper Class="pa-3" Outlined="true">
                            <MudText Typo="Typo.subtitle2">AI Lineage</MudText>
                            <MudText Typo="Typo.caption" Class="d-block mb-2">
                                Generation audit for this article and its linked resolved-ticket draft path.
                            </MudText>
                            <MudStack Spacing="1">
                                @foreach (var audit in articleAuditEntries)
                                {
                                    <MudPaper Class="pa-2" Outlined="true">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <MudText Typo="Typo.body2">@audit.OperationName</MudText>
                                            <MudText Typo="Typo.caption">@audit.CreatedAt.ToLocalTime().ToString("g")</MudText>
                                        </MudStack>
                                        <MudText Typo="Typo.caption" Class="d-block">
                                            Provider: @audit.ProviderName / @audit.ModelId
                                        </MudText>
                                        @if (!string.IsNullOrWhiteSpace(audit.SourceSubjectId))
                                        {
                                            <MudText Typo="Typo.caption" Class="d-block">
                                                Source subject: @audit.SourceSubjectId
                                            </MudText>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(audit.Notes))
                                        {
                                            <MudText Typo="Typo.caption" Class="d-block">
                                                Notes: @audit.Notes
                                            </MudText>
                                        }
                                    </MudPaper>
                                }
                            </MudStack>
                        </MudPaper>
                    }
                    <MudPaper Class="pa-3" Outlined="true">
                        <MudText Typo="Typo.subtitle2">Automation Target</MudText>
                        <MudText Typo="Typo.caption" Class="d-block mb-2">
                            Link this KB article to an approved External orchestration automation binding before exposing automation actions in AI assist.
                        </MudText>
                        <MudSelect T="string"
                                   Value="selectedAutomationBindingId"
                                   ValueChanged="OnAutomationBindingChanged"
                                   Label="External orchestration Binding"
                                   Dense="true"
                                   Disabled="@automationSaving">
                            <MudSelectItem T="string" Value="@string.Empty">No automation target</MudSelectItem>
                            @foreach (var binding in automationBindings)
                            {
                                <MudSelectItem T="string" Value="@binding.Id">
                                    @binding.RequestFormTitle / @binding.TaskTemplateName
                                </MudSelectItem>
                            }
                        </MudSelect>
                        @if (article.AutomationTarget is not null)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                                Active target:
                                <strong>@(article.AutomationTarget.TaskTemplateName ?? article.AutomationTarget.OrchestrationJobDefinitionId ?? article.AutomationTarget.OrchestrationRequestDefinitionId)</strong>
                            </MudAlert>
                        }
                        <MudStack Row="true" Spacing="1" Class="mt-2">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@automationSaving"
                                       OnClick="SaveAutomationTarget">
                                @(automationSaving ? "Saving..." : "Save Target")
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Disabled="@(automationSaving || article.AutomationTarget is null)"
                                       OnClick="ClearAutomationTarget">
                                Clear
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Check"
                               OnClick="Approve"
                               Disabled="@(article.State == KnowledgeBaseArticleState.Published)">
                        Approve & Publish
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Autorenew" OnClick="Regenerate">Regenerate</MudButton>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Archive" OnClick="Archive">Archive (Unpublish)</MudButton>
                    <MudDivider Class="my-2" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="Delete">Delete Article</MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
}


@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private ArticleDto? article;
    private KnowledgeBaseArticleStatsDto? articleStats;
    private List<KnowledgeArticleAiAuditEntryDto> articleAuditEntries = new();
    private List<AutomationBindingDto> automationBindings = new();
    private string selectedAutomationBindingId = string.Empty;
    private bool automationSaving;
    private bool loading = true;
    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");

    private Dictionary<string, (string content, List<string> listItems)> parsedContent = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var resp = await HelpdeskApi.GetFromJsonAsync<ArticleResponse>($"api/v1/kb/{Id}");
            if (resp is not null)
            {
                article = resp.Article;
                articleStats = resp.Stats;
                articleAuditEntries = resp.AuditEntries;
                selectedAutomationBindingId = article.AutomationTarget?.BindingId ?? string.Empty;
                ParseArticleContent();
            }

            automationBindings = await HelpdeskApi.GetFromJsonAsync<List<AutomationBindingDto>>("api/v1/admin/orchestration/orchestration/bindings") ?? new();
        }
        finally
        {
            loading = false;
        }
    }

    private void ParseArticleContent()
    {
        if (string.IsNullOrWhiteSpace(article?.Content)) return;

        parsedContent.Clear();
        var content = article.Content;
        var result = new Dictionary<string, (string content, List<string> listItems)>();

        // This new parser is more robust and handles the format seen in your latest screenshot.
        // It finds all known keys, orders them by their position in the text, and extracts the content between them.
        var knownKeys = new List<string>
        {
            "Title:", "Article ID:", "Summary:", "Problem Description:", "Resolution:",
            "Steps to Reproduce & Fix:", "Root Cause (Inferred):", "User Feedback:", "Notes:", "Disclaimer:"
        };

        var keyPositions = knownKeys
            .Select(k => new { Key = k.TrimEnd(':'), Index = content.IndexOf(k, StringComparison.OrdinalIgnoreCase) })
            .Where(p => p.Index != -1)
            .OrderBy(p => p.Index)
            .ToList();

        // If the procedural parser fails, fall back to the original **Title** parser
        if (keyPositions.Count == 0)
        {
            var parts = Regex.Split(content, @"\s*\*\*(.*?)\*\*\s*").Where(s => !string.IsNullOrWhiteSpace(s)).ToList();
            for (int i = 0; i < parts.Count; i += 2)
            {
                var title = parts[i].TrimEnd(':');
                var value = (i + 1 < parts.Count) ? parts[i + 1] : string.Empty;
                var listItems = Regex.Split(value, @"\s*\*\s*").Select(s => s.Trim()).Where(s => Regex.IsMatch(s, @"^\d+\.")).ToList();
                if (listItems.Any()) result[title] = (string.Empty, listItems);
                else result[title] = (value.Trim(), new List<string>());
            }
            parsedContent = result;
            return;
        }

        // --- Main Procedural Parser ---
        for (int i = 0; i < keyPositions.Count; i++)
        {
            var currentKeyPos = keyPositions[i];
            var nextKeyPos = (i + 1 < keyPositions.Count) ? keyPositions[i + 1] : null;

            var start = currentKeyPos.Index + currentKeyPos.Key.Length + 1;
            var end = nextKeyPos?.Index ?? content.Length;
            var value = content.Substring(start, end - start).Trim();

            var listItems = value.Split(new[] { '\n' }, StringSplitOptions.RemoveEmptyEntries)
                                 .Select(s => s.Trim())
                                 .Where(s => Regex.IsMatch(s, @"^\d+\.\s*"))
                                 .Select(s => Regex.Replace(s, @"^\d+\.\s*", "")) // Remove the "1. " part
                                 .ToList();

            if (listItems.Any())
            {
                result[currentKeyPos.Key] = (string.Empty, listItems);
            }
            else
            {
                result[currentKeyPos.Key] = (value, new List<string>());
            }
        }

        parsedContent = result;
    }

    private async Task Approve()
    {
        if (article is null) return;
        if (article.State == KnowledgeBaseArticleState.Published)
        {
            Snackbar.Add("Article is already published.", Severity.Info);
            return;
        }

        var dto = new UpdateKbStateDto { State = KnowledgeBaseArticleState.Published };
        var resp = await HelpdeskApi.PutAsJsonAsync($"api/v1/kb/{article.Id}/state", dto);
        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add("Article approved", Severity.Success);
            article.State = KnowledgeBaseArticleState.Published; // Update local state to reflect change
        }
        else
        {
            Snackbar.Add("Approve failed", Severity.Error);
        }
    }

    private async Task Archive()
    {
        if (article is null) return;
        var dto = new UpdateKbStateDto { State = KnowledgeBaseArticleState.Draft };
        var resp = await HelpdeskApi.PutAsJsonAsync($"api/v1/kb/{article.Id}/state", dto);
        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add("Article archived", Severity.Success);
            article.State = KnowledgeBaseArticleState.Draft; // Update local state
        }
        else
        {
            Snackbar.Add("Archive failed", Severity.Error);
        }
    }

    private async Task Regenerate()
    {
        if (article is null) return;
        var resp = await HelpdeskApi.PostAsJsonAsync($"api/v1/kb/{article.Id}/regenerate", new { });
        if (resp.IsSuccessStatusCode) Snackbar.Add("Article regenerated", Severity.Success); else Snackbar.Add("Regenerate failed", Severity.Error);
    }

    private async Task Delete()
    {
        if (article is null) return;
        var resp = await HelpdeskApi.DeleteAsync($"api/v1/kb/{article.Id}");
        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add("Article deleted", Severity.Success);
            NavigationManager.NavigateTo("/kb");
        }
        else Snackbar.Add("Delete failed", Severity.Error);
    }

    private Task OnAutomationBindingChanged(string? value)
    {
        selectedAutomationBindingId = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private async Task SaveAutomationTarget()
    {
        if (article is null)
        {
            return;
        }

        try
        {
            automationSaving = true;
            var response = await HelpdeskApi.PutAsJsonAsync(
                $"api/v1/kb/{article.Id}/automation-target",
                new UpdateKnowledgeArticleAutomationTargetDto
                {
                    BindingId = string.IsNullOrWhiteSpace(selectedAutomationBindingId) ? null : selectedAutomationBindingId,
                    ClearTarget = string.IsNullOrWhiteSpace(selectedAutomationBindingId)
                });

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Failed to save automation target.", Severity.Error);
                return;
            }

            article.AutomationTarget = await response.Content.ReadFromJsonAsync<KnowledgeArticleAutomationTargetDto>();
            selectedAutomationBindingId = article.AutomationTarget?.BindingId ?? string.Empty;
            Snackbar.Add("Automation target updated.", Severity.Success);
        }
        finally
        {
            automationSaving = false;
        }
    }

    private async Task ClearAutomationTarget()
    {
        selectedAutomationBindingId = string.Empty;
        await SaveAutomationTarget();
    }

    private class ArticleResponse
    {
        public ArticleDto Article { get; set; } = new();
        public KnowledgeBaseArticleStatsDto Stats { get; set; } = new();
        public List<KnowledgeArticleAiAuditEntryDto> AuditEntries { get; set; } = new();
    }
}
