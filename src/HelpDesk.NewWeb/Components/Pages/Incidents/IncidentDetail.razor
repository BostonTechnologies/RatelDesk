@page "/incidents/{Id}"
@attribute [Authorize(Roles = "Incident.User,Incident.Manager,HelpdeskAdmin")]

@inject ISnackbar Snackbar
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

@using Helpdesk.Shared.DTOs.Article
@using Helpdesk.Shared.DTOs.Category
@using Helpdesk.Shared.DTOs.Incident
@using Helpdesk.Shared.DTOs.Organization
@using Helpdesk.Shared.DTOs.Sla
@using Helpdesk.Shared.DTOs.User
@using Helpdesk.Shared.Enums
@using Helpdesk.Shared.Models

@implements IDisposable

<PageTitle>Incident: @(incident?.Subject ?? "...")</PageTitle>

@if (loading)
{
    <MudPaper Class="pa-4 d-flex justify-center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </MudPaper>
}
else if (incident == null)
{
    <MudAlert Severity="Severity.Error">Could not load the incident. It may not exist or an error occurred.</MudAlert>
}
else
{
    <MudGrid Spacing="3" AlignItems="AlignItems.Stretch">
        <MudItem xs="12" md="9" Class="d-flex flex-column">
            <HelpDesk.NewWeb.Components.Shared.TicketHeader
                Title="@incident.Subject"
                TrackingId="@incident.TrackingId"
                Status="@incident.State"
                Priority="@incident.Priority"
                LastUpdated="@incident.UpdatedAt"
                CustomerName="@incident.CustomerName"
                CustomerEmail="@incident.CustomerEmail"
                CategoryIds="@selectedCategoryIds"
                AllCategories="@categories"
                CategoryRemoved="OnCategoryRemoved">
                <MetadataContent>
                    @if (aiRuntimeStatus is not null)
                    {
                        <MudTooltip Placement="Placement.Bottom">
                            <ChildContent>
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@GetRuntimeColor(aiRuntimeStatus.Status)"
                                         Variant="Variant.Outlined">
                                    AI Runtime: @aiRuntimeStatus.Status
                                </MudChip>
                            </ChildContent>
                            <TooltipContent>
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.caption">
                                        Fallback: @(aiRuntimeStatus.FallbackEnabled ? $"enabled ({aiRuntimeStatus.FallbackProviderCount} alternate providers)" : "disabled")
                                    </MudText>
                                    @foreach (var provider in aiRuntimeStatus.Providers)
                                    {
                                        <MudText Typo="Typo.caption">
                                            @provider.Channel: @provider.Status via @provider.ProviderName / @provider.ModelId
                                        </MudText>
                                    }
                                    @foreach (var reason in aiRuntimeStatus.Reasons.Take(2))
                                    {
                                        <MudText Typo="Typo.caption">@reason</MudText>
                                    }
                                </MudStack>
                            </TooltipContent>
                        </MudTooltip>
                    }
                </MetadataContent>
            </HelpDesk.NewWeb.Components.Shared.TicketHeader>

            <TicketActivityTabs
                @key="activityTabsKey"
                TicketId="@Id"
                TicketType="incidents"
                OrganizationId="@incident.OrganizationId"
                PublicMode="false"
                OnWorklogAdded="HandleWorklogAdded"
                ShowAiStatusSummary="false"
                InitialAiCount="@incident.AiSuggestionCount"
                Class="flex-grow-1" />
        </MudItem>

        <MudItem xs="12" md="3" Class="d-flex flex-column">
            <MudCard Class="position-sticky compact-details-card" Style="top: 16px;">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1">Details</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="12">
                                <MudSelect T="TicketState" Value="@incident.State" ValueChanged="OnStateChanged"
                                           Dense="true"
                                           Margin="Margin.Dense"
                                           Label="Status"
                                           Variant="Variant.Outlined"
                                           Disabled="@(isUpdating)">
                                    @foreach (TicketState state in Enum.GetValues(typeof(TicketState)))
                                    {
                                        <MudSelectItem T="TicketState" Value="@state">@state.ToString()</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <MudSelect T="TicketPriority" Value="@incident.Priority" ValueChanged="OnPriorityChanged"
                                           Dense="true"
                                           Margin="Margin.Dense"
                                           Label="Priority"
                                           Variant="Variant.Outlined"
                                           Disabled="@(isUpdating)">
                                    @foreach (TicketPriority priority in Enum.GetValues(typeof(TicketPriority)))
                                    {
                                        <MudSelectItem T="TicketPriority" Value="@priority">@priority.ToString()</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <HelpDesk.NewWeb.Components.Shared.ServiceCategoryPicker
                                    RequestedType="TicketCategoryType.Incident"
                                    SelectedCategoryIds="@selectedCategoryIds"
                                    SelectedCategoryIdsChanged="OnCategorySelectionChanged"
                                    Dense="true"
                                    Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField T="string" Label="Updated" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" ReadOnly="true" Value="@incident.UpdatedAt?.ToString("g")" />
                            </MudItem>
                            @if (incident.AiSuggestionCount > 0 || incident.AiAutomationRunCount > 0 || incident.LastAiActivityAt.HasValue)
                            {
                                <MudItem xs="12">
                                    <MudDivider Class="my-2" />
                                    <MudText Typo="Typo.subtitle2" Class="mb-1">AI Summary</MudText>
                                    <MudStack Spacing="1">
                                        @if (incident.AiSuggestionCount > 0)
                                        {
                                            <MudText Typo="Typo.caption" Class="d-block">
                                                Suggestions available: @incident.AiSuggestionCount
                                            </MudText>
                                        }
                                        @if (incident.AiAutomationRunCount > 0)
                                        {
                                            <MudText Typo="Typo.caption" Class="d-block">
                                                AI-started automation runs: @incident.AiAutomationRunCount
                                            </MudText>
                                        }
                                        @if (incident.LastAiActivityAt.HasValue)
                                        {
                                            <MudText Typo="Typo.caption" Class="d-block">
                                                Last AI activity: @incident.LastAiActivityAt.Value.ToLocalTime().ToString("g")
                                            </MudText>
                                        }
                                    </MudStack>
                                </MudItem>
                            }
                            <MudItem xs="12">
                                <MudSelect T="string" Label="Assignee" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Value="@GetAssigneeSelectValue(incident.AssignedToId)" ValueChanged="OnAssigneeChanged">
                                    <MudSelectItem Value="@UnassignedAssigneeValue">Unassigned</MudSelectItem>
                                    @foreach (var u in teamMembers)
                                    {
                                        <MudSelectItem Value="@u.Id">@u.Name (@u.Email)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            @if (incident.Sla is not null)
                            {
                                <MudItem xs="12">
                                    <MudDivider Class="my-2" />
                                    <MudText Typo="Typo.subtitle2" Class="mb-1">SLA</MudText>
                                    <MudChip T="string" Color="@GetSlaStatusColor(incident.Sla.Status)" Variant="Variant.Filled" Size="Size.Small">
                                        @incident.Sla.Status
                                    </MudChip>
                                    <MudText Typo="Typo.caption" Class="d-block mt-2">
                                        Response remaining: @FormatRemaining(incident.Sla.ResponseRemainingSeconds)
                                    </MudText>
                                    <MudProgressLinear Value="@incident.Sla.ResponsePercentUsed" Color="Color.Info" Class="mb-2" />
                                    <MudText Typo="Typo.caption" Class="d-block">
                                        Resolution remaining: @FormatRemaining(incident.Sla.ResolutionRemainingSeconds)
                                    </MudText>
                                    <MudProgressLinear Value="@incident.Sla.ResolutionPercentUsed" Color="Color.Warning" Class="mb-2" />
                                    @if (!string.IsNullOrWhiteSpace(incident.Sla.PauseReason))
                                    {
                                        <MudText Typo="Typo.caption">Reason: @incident.Sla.PauseReason</MudText>
                                    }
                                    @if (incident.Sla.Status == SlaStatus.InProgress)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="mt-2" OnClick="PauseSlaAsync">Pause SLA</MudButton>
                                    }
                                    else if (incident.Sla.Status == SlaStatus.Paused)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" Class="mt-2" OnClick="ResumeSlaAsync">Resume SLA</MudButton>
                                    }
                                </MudItem>
                            }
                        </MudGrid>
                    </MudCardContent>

                    <MudCardActions Class="px-4 pb-4">
                        <MudButton OnClick="OpenCloseLinkDialogAsync"
                                   StartIcon="@Icons.Material.Filled.AccountTree"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Disabled="@isUpdating">
                            Close / Link
                        </MudButton>
                        <MudButton OnClick="RevertChanges"
                                   Disabled="!hasChanges || isUpdating">Revert</MudButton>
                        <MudButton OnClick="SaveChangesAsync"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="!hasChanges || isUpdating">
                            @if (isUpdating)
                            {
                                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                            }
                            Save Changes
                        </MudButton>
                    </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private IncidentDto? incident;
    private IncidentDto? originalIncident;
    private List<TicketCategoryDto> categories = new();
    private HashSet<Guid> selectedCategoryIds = new();
    private List<KnowledgeSuggestion> suggestions = new();
    private bool loading = true;
    private bool isUpdating;
    private bool hasChanges;
    private string? articleId;
    private bool kbWorking;
    private bool suggestionsDisabled;
    private OrganizationAiReadinessDto? aiReadiness;
    private OrganizationAiRuntimeStatusDto? aiRuntimeStatus;
    private CancellationTokenSource? pollCts;
    private int activityTabsKey;
    private const string UnassignedAssigneeValue = "__unassigned__";
    private List<UserDto> teamMembers = new();

    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");

    private string? loadedIncidentId;

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(loadedIncidentId, Id, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        loading = true;
        loadedIncidentId = Id;
        activityTabsKey++;

        try
        {
            var incidentTask = HelpdeskApi.GetFromJsonAsync<IncidentDto>($"api/v1/incidents/{Id}");
            var teamTask = HelpdeskApi.GetFromJsonAsync<List<UserDto>>("api/v1/users");
            var categoriesTask = HelpdeskApi.GetFromJsonAsync<List<TicketCategoryDto>>($"api/v1/categories?type={(int)TicketCategoryType.Incident}");

            await Task.WhenAll(incidentTask, teamTask, categoriesTask);

            originalIncident = await incidentTask;
            categories = await categoriesTask ?? new();
            categories = categories
                .GroupBy(x => x.Id)
                .Select(x => x.First())
                .OrderBy(x => x.SortOrder)
                .ThenBy(x => x.Name)
                .ToList();

            if (originalIncident != null)
            {
                incident = CloneIncident(originalIncident);
                selectedCategoryIds = incident.CategoryIds.ToHashSet();
                _ = LoadAiMetadataAsync(incident.OrganizationId);
            }

            teamMembers = await teamTask ?? new List<UserDto>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
            incident = null;
        }
        finally
        {
            loading = false;
        }
    }

    private static IncidentDto CloneIncident(IncidentDto source)
    {
        return new IncidentDto
        {
            Id = source.Id,
            OrganizationId = source.OrganizationId,
            TrackingId = source.TrackingId,
            Subject = source.Subject,
            State = source.State,
            Priority = source.Priority,
            UpdatedAt = source.UpdatedAt,
            CustomerOrgName = source.CustomerOrgName,
            CustomerId = source.CustomerId,
            CustomerName = source.CustomerName,
            CustomerEmail = source.CustomerEmail,
            LastReplierName = source.LastReplierName,
            RequesterEmail = source.RequesterEmail,
            CcRecipients = source.CcRecipients.ToList(),
            AssignedToId = source.AssignedToId,
            CategoryIds = source.CategoryIds.ToList(),
            AiSuggestionCount = source.AiSuggestionCount,
            AiAutomationRunCount = source.AiAutomationRunCount,
            LastAiActivityAt = source.LastAiActivityAt,
            Sla = source.Sla is null ? null : new TicketSlaDto
            {
                StartedAt = source.Sla.StartedAt,
                ResponseDueAt = source.Sla.ResponseDueAt,
                ResolutionDueAt = source.Sla.ResolutionDueAt,
                Status = source.Sla.Status,
                PausedAt = source.Sla.PausedAt,
                ResumeAt = source.Sla.ResumeAt,
                PauseReason = source.Sla.PauseReason,
                ResponseBreached = source.Sla.ResponseBreached,
                ResolutionBreached = source.Sla.ResolutionBreached,
                ResponseRemainingSeconds = source.Sla.ResponseRemainingSeconds,
                ResolutionRemainingSeconds = source.Sla.ResolutionRemainingSeconds,
                ResponsePercentUsed = source.Sla.ResponsePercentUsed,
                ResolutionPercentUsed = source.Sla.ResolutionPercentUsed
            }
        };
    }

    private async Task LoadAiReadinessAsync(string? organizationId)
    {
        if (string.IsNullOrWhiteSpace(organizationId))
        {
            aiReadiness = null;
            return;
        }

        try
        {
            aiReadiness = await HelpdeskApi.GetFromJsonAsync<OrganizationAiReadinessDto>($"api/v1/organizations/{organizationId}/ai-kb-settings/readiness");
        }
        catch
        {
            aiReadiness = null;
        }
    }

    private async Task LoadAiRuntimeStatusAsync(string? organizationId)
    {
        if (string.IsNullOrWhiteSpace(organizationId))
        {
            aiRuntimeStatus = null;
            return;
        }

        try
        {
            aiRuntimeStatus = await HelpdeskApi.GetFromJsonAsync<OrganizationAiRuntimeStatusDto>($"api/v1/organizations/{organizationId}/ai-kb-settings/runtime-status?timeoutMs=1500");
        }
        catch
        {
            aiRuntimeStatus = null;
        }
    }

    private async Task LoadAiMetadataAsync(string? organizationId)
    {
        await LoadAiReadinessAsync(organizationId);
        await LoadAiRuntimeStatusAsync(organizationId);
        await InvokeAsync(StateHasChanged);
    }

    private static Color GetRuntimeColor(string? status) =>
        string.Equals(status, "Ready", StringComparison.OrdinalIgnoreCase)
            ? Color.Success
            : string.Equals(status, "Degraded", StringComparison.OrdinalIgnoreCase)
                ? Color.Warning
                : Color.Error;

    private async Task EnqueueSuggestionsAndPoll()
    {
        try
        {
            kbWorking = true;

            var postResp = await HelpdeskApi.PostAsJsonAsync($"api/v1/tickets/{Id}/suggest-knowledge", new { });
            if (postResp.StatusCode == System.Net.HttpStatusCode.NoContent)
            {
                suggestionsDisabled = true;
                return;
            }

            pollCts?.Cancel();
            pollCts = new CancellationTokenSource(TimeSpan.FromSeconds(5));

            while (!pollCts.IsCancellationRequested)
            {
                var resp = await HelpdeskApi.GetAsync($"api/v1/tickets/{Id}/suggest-knowledge", pollCts.Token);

                if (resp.StatusCode == System.Net.HttpStatusCode.NoContent)
                {
                    await Task.Delay(600, pollCts.Token);
                    continue;
                }

                if (resp.IsSuccessStatusCode)
                {
                    suggestions = await resp.Content.ReadFromJsonAsync<List<KnowledgeSuggestion>>() ?? new();
                    break;
                }

                break;
            }
        }
        catch { }
        finally
        {
            kbWorking = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        pollCts?.Cancel();
        pollCts?.Dispose();
    }

    private void OnStateChanged(TicketState newState)
    {
        if (incident is null) return;
        incident.State = newState;
        hasChanges = true;
    }

    private void OnPriorityChanged(TicketPriority newPriority)
    {
        if (incident is null) return;
        incident.Priority = newPriority;
        hasChanges = true;
    }

    private void OnAssigneeChanged(string? newAssigneeId)
    {
        if (incident is null) return;
        incident.AssignedToId = string.IsNullOrWhiteSpace(newAssigneeId) || newAssigneeId == UnassignedAssigneeValue
            ? null
            : newAssigneeId;
        hasChanges = true;
    }

    private static string GetAssigneeSelectValue(string? assignedToId)
        => string.IsNullOrWhiteSpace(assignedToId) ? UnassignedAssigneeValue : assignedToId;

    private static string NormalizeAssigneePayloadValue(string? assignedToId)
        => string.IsNullOrWhiteSpace(assignedToId) ? string.Empty : assignedToId;

    private void OnCategorySelectionChanged(HashSet<Guid> categoryIds)
    {
        if (incident is null) return;
        selectedCategoryIds = categoryIds;
        incident.CategoryIds = selectedCategoryIds.ToList();
        hasChanges = true;
    }

    private async Task OnCategoryRemoved(Guid id)
    {
        if (incident is null) return;

        selectedCategoryIds.Remove(id);
        incident.CategoryIds = selectedCategoryIds.ToList();
        hasChanges = true;

        await SaveChangesAsync();
    }

    private void RevertChanges()
    {
        if (originalIncident is null || incident is null) return;

        incident.State = originalIncident.State;
        incident.Priority = originalIncident.Priority;
        incident.AssignedToId = originalIncident.AssignedToId;
        incident.CustomerId = originalIncident.CustomerId;
        incident.CustomerName = originalIncident.CustomerName;
        incident.CustomerEmail = originalIncident.CustomerEmail;
        incident.RequesterEmail = originalIncident.RequesterEmail;
        selectedCategoryIds = originalIncident.CategoryIds.ToHashSet();
        incident.CategoryIds = selectedCategoryIds.ToList();
        hasChanges = false;
    }

    private async Task SaveChangesAsync()
    {
        if (incident is null || !hasChanges) return;

        isUpdating = true;

        try
        {
            var wasResolved = originalIncident?.State == TicketState.Resolved;
            var updateDto = new UpdateIncidentDto
            {
                State = incident.State,
                Priority = incident.Priority,
                AssignedToId = NormalizeAssigneePayloadValue(incident.AssignedToId),
                CategoryIds = selectedCategoryIds.ToList()
            };

            var response = await HelpdeskApi.PutAsJsonAsync($"api/v1/incidents/{Id}", updateDto);

            if (response.IsSuccessStatusCode)
            {
                var updated = await response.Content.ReadFromJsonAsync<IncidentDto>();
                if (updated is not null)
                {
                    originalIncident = CloneIncident(updated);
                    incident = CloneIncident(updated);
                    selectedCategoryIds = updated.CategoryIds.ToHashSet();
                }
                hasChanges = false;
                Snackbar.Add("Incident saved.", Severity.Success);

                var nowResolved = incident?.State == TicketState.Resolved;
                if (!wasResolved && nowResolved)
                {
                    Snackbar.Add("Generating knowledge article & embeddings in the background…", Severity.Info);
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error saving incident: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"A client-side error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            isUpdating = false;
        }
    }

    private async Task HandleWorklogAdded()
    {
        await RefreshIncidentAsync();
    }

    private async Task OpenCloseLinkDialogAsync()
    {
        if (incident is null)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["SourceIncidentId"] = incident.Id,
            ["SourceOrganizationId"] = incident.OrganizationId ?? string.Empty
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Small
        };

        var dialog = await DialogService.ShowAsync<CloseLinkIncidentDialog>("Close / Link Incident", parameters, options);
        var result = await dialog.Result;
        if (result.Canceled)
        {
            return;
        }

        if (result.Data is List<TicketRelationCreateResultDto> relationResults && relationResults.Count > 0)
        {
            await RefreshIncidentAsync();
            activityTabsKey++;

            var relationCount = relationResults.Count;
            var copiedCount = relationResults.Sum(x => x.AddedParentListeners.Count);
            var relationText = relationCount == 1
                ? "1 relation created."
                : $"{relationCount} relations created.";
            var copiedText = copiedCount == 1
                ? "1 listener copied to the parent."
                : $"{copiedCount} listeners copied to the parent.";
            Snackbar.Add($"{relationText} {copiedText}", Severity.Success);
        }
    }

    private async Task RefreshIncidentAsync()
    {
        try
        {
            var updated = await HelpdeskApi.GetFromJsonAsync<IncidentDto>($"api/v1/incidents/{Id}");
            if (updated is not null)
            {
                originalIncident = CloneIncident(updated);
                incident = CloneIncident(updated);
                selectedCategoryIds = updated.CategoryIds.ToHashSet();
                hasChanges = false;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error refreshing incident: {ex.Message}", Severity.Error);
        }
    }

    private Task GenerateKnowledge() => GenerateOrRegenerate(false);
    private Task RegenerateKnowledge() => GenerateOrRegenerate(true);

    private async Task GenerateOrRegenerate(bool regenerate)
    {
        try
        {
            kbWorking = true;
            var url = $"api/v1/tickets/{Id}/generate-knowledge" + (regenerate ? "?regenerate=true" : string.Empty);
            var response = await HelpdeskApi.PostAsJsonAsync(url, new { });
            if (response.IsSuccessStatusCode)
            {
                var article = await response.Content.ReadFromJsonAsync<ArticleDto>();
                if (article is not null)
                {
                    articleId = article.Id;
                    Snackbar.Add(regenerate ? "Article regenerated." : "Draft article generated.", Severity.Success);
                    NavigationManager.NavigateTo($"/kb/{article.Id}");
                }
            }
            else
            {
                Snackbar.Add("Knowledge generation failed.", Severity.Error);
            }
        }
        finally
        {
            kbWorking = false;
        }
    }

    private async Task ApproveKnowledge()
    {
        if (articleId is null) return;
        try
        {
            kbWorking = true;
            var dto = new UpdateKbStateDto { State = KnowledgeBaseArticleState.Published };
            var response = await HelpdeskApi.PutAsJsonAsync($"api/v1/kb/{articleId}/state", dto);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Article approved.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Approval failed.", Severity.Error);
            }
        }
        finally
        {
            kbWorking = false;
        }
    }

    private async Task PauseSlaAsync()
    {
        var dialog = await DialogService.ShowAsync<HelpDesk.NewWeb.Components.Shared.SlaPauseDialog>(
            "Pause SLA",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result.Canceled || result.Data is not PauseSlaRequest request)
        {
            return;
        }

        var response = await HelpdeskApi.PostAsJsonAsync($"api/v1/tickets/{Id}/sla/pause", request);
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add("Failed to pause SLA.", Severity.Error);
            return;
        }

        await HandleWorklogAdded();
    }

    private async Task ResumeSlaAsync()
    {
        var response = await HelpdeskApi.PostAsJsonAsync($"api/v1/tickets/{Id}/sla/resume", new ResumeSlaRequest());
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add("Failed to resume SLA.", Severity.Error);
            return;
        }

        await HandleWorklogAdded();
    }

    private static string FormatRemaining(long totalSeconds)
    {
        if (totalSeconds <= 0) return "0m";
        var span = TimeSpan.FromSeconds(totalSeconds);
        if (span.TotalDays >= 1) return $"{(int)span.TotalDays}d {span.Hours}h";
        if (span.TotalHours >= 1) return $"{(int)span.TotalHours}h {span.Minutes}m";
        return $"{Math.Max(1, span.Minutes)}m";
    }

    private static Color GetSlaStatusColor(SlaStatus status) => status switch
    {
        SlaStatus.InProgress => Color.Info,
        SlaStatus.Paused => Color.Warning,
        SlaStatus.Breached => Color.Error,
        SlaStatus.Completed => Color.Success,
        _ => Color.Default
    };

}
