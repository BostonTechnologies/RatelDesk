@page "/setup"
@attribute [AllowAnonymous]

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>Set up RatelDesk</PageTitle>

<section class="helpdesk-login-page">
    <MudPaper Elevation="2" Class="helpdesk-login-panel">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h4" HtmlTag="h1">Set up RatelDesk</MudText>
            <MudText Typo="Typo.body1">Enter the operator setup code, then create the first local instance administrator.</MudText>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error">@_error</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(_completionMessage))
            {
                <MudAlert Severity="Severity.Success">@_completionMessage</MudAlert>
            }

            <MudTextField T="string" @bind-Value="_setupCode" Label="Setup code" InputType="InputType.Password" Required="true" />
            <MudSelect T="string" @bind-Value="_storageProvider" Label="Storage provider" Required="true">
                <MudSelectItem Value="@("Sqlite")">Embedded SQLite — no database service required</MudSelectItem>
                <MudSelectItem Value="@("PostgreSql")">PostgreSQL</MudSelectItem>
            </MudSelect>
            @if (string.Equals(_storageProvider, "PostgreSql", StringComparison.OrdinalIgnoreCase))
            {
                <MudTextField T="string" @bind-Value="_postgreSqlHost" Label="PostgreSQL host" Required="true" />
                <MudTextField T="int" @bind-Value="_postgreSqlPort" Label="Port" Required="true" />
                <MudTextField T="string" @bind-Value="_postgreSqlDatabase" Label="Database" Required="true" />
                <MudTextField T="string" @bind-Value="_postgreSqlUsername" Label="Username" Required="true" />
                <MudTextField T="string" @bind-Value="_postgreSqlPassword" Label="Password" InputType="InputType.Password" Required="true" />
                <MudCheckBox T="bool" @bind-Value="_postgreSqlUseTls" Label="Require TLS" Color="Color.Primary" />
                <MudText Typo="Typo.caption">The target must be empty or an established RatelDesk database with vector and pg_trgm installed.</MudText>
            }
            <MudTextField T="string" @bind-Value="_organizationName" Label="Initial organization" Required="true" />
            <MudTextField T="string" @bind-Value="_applicationName" Label="Application name (optional)" />
            <MudTextField T="string" @bind-Value="_applicationUrl" Label="Public application URL" InputType="InputType.Url" Required="true" HelperText="Use the HTTPS URL that operators and end users will open." />
            <MudDivider />
            <MudText Typo="Typo.h6">First administrator</MudText>
            <MudTextField T="string" @bind-Value="_displayName" Label="Display name" Required="true" />
            <MudTextField T="string" @bind-Value="_email" Label="Email" InputType="InputType.Email" Required="true" />
            <MudTextField T="string" @bind-Value="_password" Label="Password" InputType="InputType.Password" Required="true" />
            <MudTextField T="string" @bind-Value="_confirmPassword" Label="Confirm password" InputType="InputType.Password" Required="true" HelperText="Use a memorable passphrase of at least 15 characters." />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="InitializeAsync">
                @(_busy ? "Initializing…" : "Initialize instance")
            </MudButton>
        </MudStack>
    </MudPaper>
</section>

@code {
    private string _setupCode = string.Empty;
    private string _storageProvider = "Sqlite";
    private string _postgreSqlHost = string.Empty;
    private int _postgreSqlPort = 5432;
    private string _postgreSqlDatabase = string.Empty;
    private string _postgreSqlUsername = string.Empty;
    private string _postgreSqlPassword = string.Empty;
    private bool _postgreSqlUseTls = true;
    private string _organizationName = string.Empty;
    private string _applicationName = string.Empty;
    private string _applicationUrl = string.Empty;
    private string _displayName = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _error;
    private string? _completionMessage;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var status = await HttpClientFactory.CreateClient("SystemApiNoAuth")
                .GetFromJsonAsync<SetupStatus>("/api/v1/setup/status");
            if (status?.State.ValueKind == System.Text.Json.JsonValueKind.String &&
                string.Equals(status.State.GetString(), "Ready", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/login", forceLoad: true);
            }
        }
        catch (HttpRequestException)
        {
            // The setup host can still be starting; the page remains usable and
            // reports the request error when the operator submits setup.
            System.Diagnostics.Debug.WriteLine("Setup status endpoint unavailable while rendering setup.");
        }
    }

    private async Task InitializeAsync()
    {
        _busy = true;
        _error = null;
        _completionMessage = null;
        try
        {
            if (!Uri.TryCreate(_applicationUrl, UriKind.Absolute, out var applicationUri) ||
                applicationUri.Scheme is not ("https" or "http"))
            {
                _error = "Enter a valid public application URL.";
                return;
            }

            if (!string.Equals(_password, _confirmPassword, StringComparison.Ordinal))
            {
                _error = "The administrator passwords do not match.";
                return;
            }

            var client = HttpClientFactory.CreateClient("SystemApiNoAuth");
            using var sessionResponse = await client.PostAsJsonAsync("/api/v1/setup/session", new { setupCode = _setupCode });
            if (!sessionResponse.IsSuccessStatusCode)
            {
                _error = "The setup code was not accepted.";
                return;
            }

            var session = await sessionResponse.Content.ReadFromJsonAsync<SetupSession>();
            if (string.IsNullOrWhiteSpace(session?.Session))
            {
                _error = "A setup session could not be created.";
                return;
            }

            using var storageRequest = new HttpRequestMessage(HttpMethod.Post, "/api/v1/setup/storage")
            {
                Content = JsonContent.Create(new
                {
                    provider = _storageProvider,
                    postgreSqlHost = _storageProvider == "PostgreSql" ? _postgreSqlHost : null,
                    postgreSqlPort = _storageProvider == "PostgreSql" ? _postgreSqlPort : (int?)null,
                    postgreSqlDatabase = _storageProvider == "PostgreSql" ? _postgreSqlDatabase : null,
                    postgreSqlUsername = _storageProvider == "PostgreSql" ? _postgreSqlUsername : null,
                    postgreSqlPassword = _storageProvider == "PostgreSql" ? _postgreSqlPassword : null,
                    postgreSqlUseTls = _postgreSqlUseTls
                })
            };
            storageRequest.Headers.Add("X-RatelDesk-Setup-Session", session.Session);
            using var storageResponse = await client.SendAsync(storageRequest);
            if (!storageResponse.IsSuccessStatusCode)
            {
                _error = $"{_storageProvider} storage could not be prepared.";
                return;
            }

            using var initializeRequest = new HttpRequestMessage(HttpMethod.Post, "/api/v1/setup/initialize")
            {
                Content = JsonContent.Create(new
                {
                    email = _email,
                    displayName = _displayName,
                    password = _password,
                    organizationName = _organizationName,
                    applicationName = string.IsNullOrWhiteSpace(_applicationName) ? null : _applicationName,
                    applicationUrl = applicationUri.AbsoluteUri
                })
            };
            initializeRequest.Headers.Add("X-RatelDesk-Setup-Session", session.Session);
            using var initializeResponse = await client.SendAsync(initializeRequest);
            if (!initializeResponse.IsSuccessStatusCode)
            {
                _error = "Initialization could not be completed. Check the administrator password and setup details.";
                return;
            }

            _password = string.Empty;
            _confirmPassword = string.Empty;
            _completionMessage = "Initialization is complete. RatelDesk is restarting the API and will open sign-in shortly.";
            await Task.Delay(TimeSpan.FromSeconds(2));
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _error = "The setup service is unavailable. Please retry.";
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed record SetupSession(string Session);

    private sealed record SetupStatus(System.Text.Json.JsonElement State);
}
