    private void RevertChanges()
    {
        if (originalChange is null || change is null) return;

        change.State = originalChange.State;
        change.LifecycleState = originalChange.LifecycleState;
        change.Priority = originalChange.Priority;
        change.OrganizationId = originalChange.OrganizationId;
        change.OrganizationName = originalChange.OrganizationName;
        change.CustomerOrgName = originalChange.CustomerOrgName;
        change.CustomerId = originalChange.CustomerId;
        change.CustomerName = originalChange.CustomerName;
        change.CustomerEmail = originalChange.CustomerEmail;
        change.ChangeType = originalChange.ChangeType;
        change.ImplementationStartAt = originalChange.ImplementationStartAt;
        change.ImplementationEndAt = originalChange.ImplementationEndAt;
        change.ChangeTemplate = originalChange.ChangeTemplate is null
            ? new ChangeTemplateDto()
            : JsonSerializer.Deserialize<ChangeTemplateDto>(JsonSerializer.Serialize(originalChange.ChangeTemplate)) ?? new ChangeTemplateDto();
        change.IsTemplateComplete = originalChange.IsTemplateComplete;
        change.TemplateValidationErrors = originalChange.TemplateValidationErrors.ToList();
        selectedCategoryIds = originalChange.CategoryIds.ToHashSet();
        change.CategoryIds = selectedCategoryIds.ToList();
        templateErrors = change.TemplateValidationErrors.ToList();
        SyncImplementationWindowEditors(change);
        hasChanges = false;
    }

    private async Task SaveChangesAsync()
    {
        if (!CanManage || change is null || !hasChanges) return;

        isUpdating = true;

        try
        {
            var updateDto = BuildUpdateDto();

            var response = await HelpdeskApi.PutAsJsonAsync($"api/v1/changes/{Id}", updateDto);

            if (response.IsSuccessStatusCode)
            {
                var updated = await response.Content.ReadFromJsonAsync<ChangeDto>();
                if (updated is not null)
                {
                    originalChange = CloneChange(updated);
                    change = CloneChange(updated);
                    change.ChangeTemplate ??= new ChangeTemplateDto();
                    SyncImplementationWindowEditors(change);
                    selectedCategoryIds = updated.CategoryIds.ToHashSet();
                    templateErrors = updated.TemplateValidationErrors.ToList();
                    hasChanges = false;
                }
                Snackbar.Add("Change saved successfully!", Severity.Success);
            }
            else
            {
                templateErrors = await ReadErrorsAsync(response);
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add(
                    templateErrors.Count > 0 ? "Complete the required template fields or AI-review requirements before saving." : $"Error saving change: {error}",
                    Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"A client-side error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            isUpdating = false;
        }
    }

    private async Task HandleWorklogAdded()
    {
        try
        {
            var updated = await HelpdeskApi.GetFromJsonAsync<ChangeDto>($"api/v1/changes/{Id}");
            if (updated is not null)
            {
                originalChange = CloneChange(updated);
                change = CloneChange(updated);
                change.ChangeTemplate ??= new ChangeTemplateDto();
                SyncImplementationWindowEditors(change);
                selectedCategoryIds = updated.CategoryIds.ToHashSet();
                templateErrors = updated.TemplateValidationErrors.ToList();
                hasChanges = false;
            }
            await LoadAiReviewAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error refreshing change: {ex.Message}", Severity.Error);
        }
    }

    private UpdateChangeDto BuildUpdateDto()
    {
        if (change is null)
        {
            return new UpdateChangeDto();
        }

        if (originalChange is not null &&
            IsChangeLocked &&
            change.LifecycleState != originalChange.LifecycleState &&
            change.State == originalChange.State &&
            change.Priority == originalChange.Priority &&
            string.Equals(change.OrganizationId, originalChange.OrganizationId, StringComparison.Ordinal) &&
            Nullable.Compare(change.ImplementationStartAt, originalChange.ImplementationStartAt) == 0 &&
            Nullable.Compare(change.ImplementationEndAt, originalChange.ImplementationEndAt) == 0 &&
            string.Equals(change.ChangeType, originalChange.ChangeType, StringComparison.Ordinal) &&
            selectedCategoryIds.SetEquals(originalChange.CategoryIds))
        {
            return new UpdateChangeDto
            {
                State = originalChange.State,
                Priority = originalChange.Priority,
                LifecycleState = change.LifecycleState
            };
        }

        return new UpdateChangeDto
        {
            State = change.State,
            LifecycleState = change.LifecycleState,
            Priority = change.Priority,
            OrganizationId = change.OrganizationId,
            ImplementationStartAt = change.ImplementationStartAt,
            ImplementationEndAt = change.ImplementationEndAt,
            ChangeType = change.ChangeType,
            ChangeTemplate = change.ChangeTemplate,
            CategoryIds = selectedCategoryIds.ToList()
        };
    }

