    private async Task EnqueueSuggestionsAndPoll()
    {
        try
        {
            kbWorking = true;

            var postResp = await HelpdeskApi.PostAsJsonAsync($"api/v1/tickets/{Id}/suggest-knowledge", new { });
            if (postResp.StatusCode == System.Net.HttpStatusCode.NoContent)
            {
                suggestionsDisabled = true;
                return;
            }

            pollCts?.Cancel();
            pollCts = new CancellationTokenSource(TimeSpan.FromSeconds(5));

            while (!pollCts.IsCancellationRequested)
            {
                var resp = await HelpdeskApi.GetAsync($"api/v1/tickets/{Id}/suggest-knowledge", pollCts.Token);

                if (resp.StatusCode == System.Net.HttpStatusCode.NoContent)
                {
                    await Task.Delay(600, pollCts.Token);
                    continue;
                }

                if (resp.IsSuccessStatusCode)
                {
                    suggestions = await resp.Content.ReadFromJsonAsync<List<KnowledgeSuggestion>>() ?? new();
                    break;
                }

                break;
            }
        }
        catch { }
        finally
        {
            kbWorking = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        pollCts?.Cancel();
        pollCts?.Dispose();
    }

