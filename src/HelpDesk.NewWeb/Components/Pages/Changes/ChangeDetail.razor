    private static string FormatRemaining(long totalSeconds)
    {
        if (totalSeconds <= 0) return "0m";
        var span = TimeSpan.FromSeconds(totalSeconds);
        if (span.TotalDays >= 1) return $"{(int)span.TotalDays}d {span.Hours}h";
        if (span.TotalHours >= 1) return $"{(int)span.TotalHours}h {span.Minutes}m";
        return $"{Math.Max(1, span.Minutes)}m";
    }

    private async Task RunAiReviewAsync(bool force)
    {
        if (change is null)
        {
            return;
        }

        aiReviewBusy = true;
        try
        {
            if (hasChanges)
            {
                await SaveChangesAsync();
                if (hasChanges)
                {
                    return;
                }
            }

            var response = await HelpdeskApi.PostAsJsonAsync(
                $"api/v1/changes/{Id}/ai-review",
                new RunChangeAiReviewRequestDto { Force = force });
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"AI review failed: {error}", Severity.Error);
                return;
            }

            aiReview = await response.Content.ReadFromJsonAsync<ChangeAiReviewDto>();
            await HandleWorklogAdded();
            await LoadAiReviewAsync();
            Snackbar.Add(force ? "AI review re-ran successfully." : "AI review completed successfully.", Severity.Success);
        }
        finally
        {
            aiReviewBusy = false;
        }
    }

    private async Task AcknowledgeAiReviewAsync()
    {
        aiReviewBusy = true;
        try
        {
            var response = await HelpdeskApi.PostAsJsonAsync(
                $"api/v1/changes/{Id}/ai-review/acknowledge",
                new AcknowledgeChangeAiReviewDto());
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Could not acknowledge AI review warnings: {error}", Severity.Error);
                return;
            }

            await HandleWorklogAdded();
            await LoadAiReviewAsync();
            Snackbar.Add("AI review warnings acknowledged.", Severity.Success);
        }
        finally
        {
            aiReviewBusy = false;
        }
    }

