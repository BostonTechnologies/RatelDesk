@implements IDisposable
@inject NavigationManager NavigationManager

<MudNavMenu>
    <MudNavLink Href="home" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>

    <AuthorizeView Roles="SelfService.User,HelpdeskAdmin">
        <MudNavGroup Title="Portal" Icon="@Icons.Material.Filled.Apps" Expanded="false">
            <MudNavLink Href="self-service" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Storefront">Self Service</MudNavLink>
            <MudNavLink Href="self-service/my-requests" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReceiptLong">My Requests</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="Incident.User,Incident.Manager,Request.User,Request.Manager,Change.User,Change.Manager,DataManagement.Admin,HelpdeskAdmin">
        @*
        <MudNavLink Href="/technician/dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dashboard">Technician Dashboard</MudNavLink>
        *@
        
        <MudNavGroup Title="Workspace" Icon="@Icons.Material.Filled.Workspaces" Expanded="false">
            <AuthorizeView Roles="Incident.User,Incident.Manager,HelpdeskAdmin" Context="incidentAuth">
                <MudNavLink Href="incidents" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ListAlt">Incidents</MudNavLink>
            </AuthorizeView>
            <AuthorizeView Roles="Request.User,Request.Manager,HelpdeskAdmin" Context="requestAuth">
                <MudNavLink Href="requests" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.List">Requests</MudNavLink>
                <MudNavLink Href="tasks" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.TaskAlt">Tasks</MudNavLink>
            </AuthorizeView>
            <AuthorizeView Roles="Change.User,Change.Manager,HelpdeskAdmin" Context="changeAuth">
                <MudNavLink Href="changes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ChangeCircle">Changes</MudNavLink>
            </AuthorizeView>
        </MudNavGroup>

        <AuthorizeView Roles="Incident.Manager,Request.Manager,Change.Manager,HelpdeskAdmin" Context="opsGate">
        <MudNavGroup Title="Operations" Icon="@Icons.Material.Filled.SettingsSuggest" Expanded="false">
            <MudNavLink Href="/ops/slas" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Schedule">SLA Ops</MudNavLink>
            <MudNavLink Href="/ops/workflows" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountTree">Workflow Ops</MudNavLink>
            <MudNavLink Href="notifications" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Notifications">Notifications</MudNavLink>
            <AuthorizeView Roles="HelpdeskAdmin" Context="operationsAuth">
                <MudNavLink Href="/ops/hangfire" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Timer">Hangfire Ops</MudNavLink>
                <MudNavLink Href="/settings/connectivity" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CloudSync">Connectivity</MudNavLink>
                <MudNavLink Href="/admin/pending-emails" Icon="@Icons.Material.Filled.MarkunreadMailbox">Pending Emails</MudNavLink>
            </AuthorizeView>
        </MudNavGroup>
        </AuthorizeView>

        <AuthorizeView Roles="Incident.Manager,Request.Manager,Change.Manager,DataManagement.Admin,HelpdeskAdmin" Context="resourcesGate">
        <MudNavGroup Title="Resources" Icon="@Icons.Material.Filled.Source" Expanded="false">
             <AuthorizeView Roles="HelpdeskAdmin" Context="assetAuth">
                <MudNavLink Href="assets" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inventory">Assets</MudNavLink>
             </AuthorizeView>
             <AuthorizeView Roles="HelpdeskAdmin,DataManagement.Admin" Context="dataManagementAuth">
                <MudNavLink Href="/admin/resources/data-management" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.DataObject">Data Management</MudNavLink>
             </AuthorizeView>
             <AuthorizeView Roles="HelpdeskAdmin" Context="resourceAdmin">
                <MudNavGroup Title="Knowledge" Icon="@Icons.Material.Filled.Article" Expanded="false">
                    <MudNavLink Href="kb" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Article">Knowledge</MudNavLink>
                    <MudNavLink Href="/admin/knowledgebase/articles" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.EditNote">Articles</MudNavLink>
                    <MudNavLink Href="/admin/kb/categories" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Category">Categories</MudNavLink>
                    <MudNavLink Href="/kb/health" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MonitorHeart">Health</MudNavLink>
                </MudNavGroup>
             </AuthorizeView>
        </MudNavGroup>
        </AuthorizeView>
    </AuthorizeView>

    <MudDivider Class="my-2" />

    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="auth" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Person">@context.User.Identity?.Name</MudNavLink>
            <TenantAdministrationNavigation />
            <AuthorizeView Roles="HelpdeskAdmin" Context="adminAuth">
                <MudNavGroup Title="Administration" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
                    <MudNavGroup Title="Accounts & Orgs" Icon="@Icons.Material.Filled.AccountTree" Expanded="false">
                        <MudNavLink Href="/admin/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Group">Team</MudNavLink>
                        <MudNavLink Href="/admin/customers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">
                            Customers
                        </MudNavLink>
                        <MudNavLink Href="/admin/organizations" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Apartment">
                            Organizations
                        </MudNavLink>
                        <MudNavLink Href="/admin/support-routing" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SupportAgent">
                            Support Routing
                        </MudNavLink>
                        <MudNavLink Href="/admin/tenant-sla-settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Tune">Tenant SLA Settings</MudNavLink>
                    </MudNavGroup>

                    <MudNavLink Href="/admin/roles" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Security">Roles & Permissions</MudNavLink>
                    <MudNavLink Href="/admin/automation" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SmartToy">Automation Rules</MudNavLink>
                    <MudNavLink Href="/admin/requests/services" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Apps">Service Explorer</MudNavLink>
                    <MudNavLink Href="/admin/categories" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Category">Ticket Categories</MudNavLink>
                    <MudNavLink Href="/admin/ai-assistant-webhooks" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Webhook">Webhooks</MudNavLink>
                    <MudNavLink Href="/admin/branding" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Palette">Branding &amp; Identity</MudNavLink>

                    <MudNavGroup Title="Email Design" Icon="@Icons.Material.Filled.Email" Expanded="false">
                        <MudNavLink Href="/admin/email-rules" Icon="@Icons.Material.Filled.Rule">Email Rules</MudNavLink>
                        <MudNavLink Href="/admin/templates" Icon="@Icons.Material.Filled.Email">Email Templates</MudNavLink>
                        <MudNavLink Href="/admin/layouts" Icon="@Icons.Material.Filled.ViewQuilt">Email Layouts</MudNavLink>
                    </MudNavGroup>
                </MudNavGroup>
            </AuthorizeView>
            <MudNavLink Href="/logout" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Logout">Logout</MudNavLink>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="/login" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Login">Login</MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>


@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
