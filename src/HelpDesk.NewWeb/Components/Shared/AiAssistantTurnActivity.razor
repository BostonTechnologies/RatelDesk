@using HelpDesk.NewWeb.Services
@using Helpdesk.Shared.AiAssistant.Chat
@using System.Text.Json

<section class="ai-assistant-activity" data-testid="ai-assistant-activity">
    <button type="button" class="activity-heading" aria-expanded="@expanded.ToString().ToLowerInvariant()" @onclick="Toggle">
        <MudIcon Icon="@(expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
        <span>AiAssistant activity · @Turn.Summary</span>
        @if (HasPendingApproval)
        {
            <span class="approval-heading-status">
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" />
                <span>Approval required</span>
            </span>
        }
        @if (!Turn.Completed && State == ChatState.Processing)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            <span>Working…</span>
        }
    </button>
    @if (expanded)
    {
        @foreach (var operation in Turn.Operations)
        {
            var metadata = operation.Metadata;
            <div class="activity-row" @key="operation.Sequence">
                <MudIcon Icon="@Icon(metadata)" Color="@(metadata?.Outcome == "failed" ? Color.Error : Color.Default)" />
                <span class="activity-name">@(metadata is null ? "Tool activity (legacy record)" : $"{metadata.ProviderName ?? (metadata.ToolKind == "skill" ? "Skill" : "")}{(metadata.ProviderName is not null || metadata.ToolKind == "skill" ? " · " : "")}{metadata.DisplayName}")</span>
                <span>@(metadata?.Outcome ?? (operation.Result is null ? "Running" : "Finished"))</span>
                @if (metadata?.DurationMs is { } ms) { <span>@((ms / 1000d).ToString("0.##"))s</span> }
            </div>
        }
        @foreach (var item in Turn.Activity)
        {
            var isPendingApproval = IsPendingApproval(item);
            <div class="@(isPendingApproval ? "activity-interaction approval-callout" : "activity-interaction")"
                 data-testid="@(isPendingApproval ? "ai-assistant-approval" : null)">
                @if (isPendingApproval)
                {
                    <div class="approval-status" role="status" aria-live="polite">
                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" />
                        <MudText Typo="Typo.subtitle2">Approval required</MudText>
                    </div>
                }
                <MudText Style="white-space: pre-wrap; overflow-wrap: anywhere">@item.Text</MudText>
                @if (isPendingApproval)
                {
                    <div class="approval-actions">
                        @foreach (var option in JsonSerializer.Deserialize<List<ChatOption>>(item.OptionsJson ?? "[]") ?? [])
                        {
                            <MudButton Class="approval-action"
                                       Color="@ApprovalColor(option.Key)"
                                       Variant="@ApprovalVariant(option.Key)"
                                       StartIcon="@ApprovalIcon(option.Key)"
                                       Disabled="Busy"
                                       data-approval-key="@option.Key"
                                       OnClick="@(() => Approval.InvokeAsync((item.CallId!, option.Key)))">@option.Label</MudButton>
                        }
                    </div>
                }
            </div>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public ChatTurn Turn { get; set; } = null!;
    [Parameter] public ChatState State { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<(string CallId, string Key)> Approval { get; set; }
    private bool expanded, initialized, completed;
    protected override void OnParametersSet()
    {
        if (!initialized || completed != Turn.Completed) expanded = Turn.InitiallyExpanded;
        if (Turn.HasError || (Turn.HasPendingApproval && State != ChatState.Archived)) expanded = true;
        completed = Turn.Completed; initialized = true;
    }
    private void Toggle() => expanded = !expanded;
    private bool HasPendingApproval => Turn.Activity.Any(IsPendingApproval);
    private bool IsPendingApproval(AiAssistantChatEvent item) => item.Type == "approval_request"
        && State == ChatState.AwaitingApproval
        && !Turn.Activity.Any(x => x.Type == "approval_response" && x.CallId == item.CallId);
    private static Color ApprovalColor(string key) => key == "deny" ? Color.Error : Color.Primary;
    private static Variant ApprovalVariant(string key) => key == "deny" ? Variant.Outlined : Variant.Filled;
    private static string ApprovalIcon(string key) => key == "deny"
        ? Icons.Material.Filled.Block
        : Icons.Material.Filled.CheckCircle;
    private static string Icon(ChatActivityMetadata? metadata) => metadata?.Outcome == "failed" ? Icons.Material.Filled.ErrorOutline
        : metadata?.ToolKind switch
        {
            "skill" => Icons.Material.Filled.MenuBook,
            "mcp" => Icons.Material.Filled.Hub,
            "discovery" => Icons.Material.Filled.Search,
            _ => Icons.Material.Filled.Build
        };
}
