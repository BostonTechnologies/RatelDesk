@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<AiAssistantComposer> Logger

<div class="chat-composer" @ref="root" data-testid="ai-assistant-composer">
    <textarea aria-label="Message AiAssistant" placeholder="Message AiAssistant…" rows="2"
              value="@Value" @oninput="ChangedAsync" disabled="@Disabled" maxlength="16000"></textarea>
    <div class="composer-actions">
        <span class="composer-hint">Shift+Enter for a new line</span>
        <button type="button" class="composer-send" data-chat-send disabled="@(Disabled || string.IsNullOrWhiteSpace(Value))" @onclick="SendAsync">
            <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" /> Send
        </button>
    </div>
</div>
<MudText Typo="Typo.caption">Images and files cannot be sent to AiAssistant yet. Ticket attachments are not automatically visible to the assistant.</MudText>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback Send { get; set; }
    private ElementReference root;
    private IJSObjectReference? module;
    private bool disposed;
    private Task ChangedAsync(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value?.ToString() ?? "");
    private Task SendAsync() => Disabled || string.IsNullOrWhiteSpace(Value) ? Task.CompletedTask : Send.InvokeAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return;
        if (firstRender)
        {
            var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/AiAssistantComposer.razor.js");
            if (disposed) { await imported.DisposeAsync(); return; }
            module = imported;
            await module.InvokeVoidAsync("attach", root);
        }
        if (module is not null && !disposed) await module.InvokeVoidAsync("resize", root);
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (module is null) return;
        try
        {
            try { await module.InvokeVoidAsync("detach", root); }
            finally { await module.DisposeAsync(); }
        }
        catch (JSDisconnectedException) { Logger.LogDebug("Chat composer circuit disconnected during disposal."); }
    }
}
