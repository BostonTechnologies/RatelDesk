            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to approve automation: {ex.Message}", Severity.Error);
        }
        finally
        {
            automationApprovalRunning = false;
        }
    }

    private async Task RefreshAutomationRunsAsync()
    {
