    private async Task LoadFeedbackAsync()
    {
        var response = await HelpdeskApi.GetAsync($"api/v1/tickets/{TicketId}/ai-feedback");
        feedbackEntries = response.IsSuccessStatusCode
            ? await response.Content.ReadFromJsonAsync<List<TicketAiFeedbackDto>>() ?? new()
            : new List<TicketAiFeedbackDto>();
    }

    private async Task LoadAutomationValidationAsync()
    {
        automationValidationResults = new Dictionary<string, TicketAutomationValidationDto>(StringComparer.OrdinalIgnoreCase);
        automationValidationLoading.Clear();

        if (!string.Equals(TicketType, "incidents", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var articleIds = suggestions
            .Where(x => x.AutomationTarget is not null && !string.IsNullOrWhiteSpace(x.ArticleId))
            .Select(x => x.ArticleId)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var articleId in articleIds)
        {
            automationValidationLoading.Add(articleId);
            try
            {
                var response = await HelpdeskApi.GetAsync($"api/v1/tickets/{TicketId}/automation-approvals/{articleId}/validation");
                var result = await response.Content.ReadFromJsonAsync<TicketAutomationValidationDto>();
                if (result is not null)
                {
                    automationValidationResults[articleId] = result;
                }
                else if (!response.IsSuccessStatusCode)
                {
                    automationValidationResults[articleId] = new TicketAutomationValidationDto
                    {
                        ArticleId = articleId,
                        CanApprove = false,
                        Summary = "Automation validation failed.",
                        Errors = ["Automation validation failed."]
                    };
                }
            }
            catch
            {
                automationValidationResults[articleId] = new TicketAutomationValidationDto
                {
                    ArticleId = articleId,
                    CanApprove = false,
                    Summary = "Automation validation failed.",
                    Errors = ["Automation validation failed."]
                };
            }
            finally
            {
                automationValidationLoading.Remove(articleId);
            }
        }
    }

    private TicketAiFeedbackDto? GetLatestFeedback(string feedbackType, string? articleId = null, string? requestId = null)
    {
        return feedbackEntries.FirstOrDefault(x =>
            string.Equals(x.FeedbackType, feedbackType, StringComparison.OrdinalIgnoreCase)
            && (articleId is null || string.Equals(x.ArticleId, articleId, StringComparison.OrdinalIgnoreCase))
            && (requestId is null || string.Equals(x.RequestId, requestId, StringComparison.OrdinalIgnoreCase)));
    }

