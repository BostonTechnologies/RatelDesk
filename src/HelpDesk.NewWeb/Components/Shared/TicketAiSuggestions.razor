        catch (Exception ex)
        {
            Snackbar.Add($"Failed to record AI feedback: {ex.Message}", Severity.Error);
        }
        finally
        {
            feedbackSubmitting = false;
        }
    }

    private async Task LoadAiReadinessAsync()
    {
        if (string.IsNullOrWhiteSpace(OrganizationId))
        {
            aiReadiness = null;
            return;
        }

        var response = await HelpdeskApi.GetAsync($"api/v1/organizations/{OrganizationId}/ai-kb-settings/readiness");
        aiReadiness = response.IsSuccessStatusCode
            ? await response.Content.ReadFromJsonAsync<OrganizationAiReadinessDto>()
            : null;

        var runtimeResponse = await HelpdeskApi.GetAsync($"api/v1/organizations/{OrganizationId}/ai-kb-settings/runtime-status");
        aiRuntimeStatus = runtimeResponse.IsSuccessStatusCode
            ? await runtimeResponse.Content.ReadFromJsonAsync<OrganizationAiRuntimeStatusDto>()
            : null;
    }

    private static Severity GetRuntimeSeverity(string? status) =>
        string.Equals(status, "Ready", StringComparison.OrdinalIgnoreCase)
            ? Severity.Success
            : string.Equals(status, "Degraded", StringComparison.OrdinalIgnoreCase)
                ? Severity.Warning
                : Severity.Error;

    private static Color GetChangeReviewColor(ChangeAiReviewDto review) =>
        review.Status switch
        {
            ChangeReviewStatus.Complete when review.GateState == ChangeReviewGateState.Pass => Color.Success,
            ChangeReviewStatus.Complete when review.GateState == ChangeReviewGateState.Acknowledged => Color.Info,
            ChangeReviewStatus.Complete when review.GateState == ChangeReviewGateState.Warning => Color.Warning,
            ChangeReviewStatus.Pending => Color.Info,
            ChangeReviewStatus.Failed => Color.Error,
            ChangeReviewStatus.Stale => Color.Warning,
            _ => Color.Default
        };

    private static string GetChangeReviewLabel(ChangeAiReviewDto review) =>
        review.Status switch
        {
            ChangeReviewStatus.Complete when review.GateState == ChangeReviewGateState.Pass => "Passed",
            ChangeReviewStatus.Complete when review.GateState == ChangeReviewGateState.Acknowledged => "Acknowledged",
            ChangeReviewStatus.Complete when review.GateState == ChangeReviewGateState.Warning => "Warning",
            ChangeReviewStatus.Pending => "Pending",
            ChangeReviewStatus.Failed => "Failed",
            ChangeReviewStatus.Stale => "Stale",
            _ => "Not Run"
        };
}
