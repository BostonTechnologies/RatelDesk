@using Helpdesk.Shared.DTOs.Worklog

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Add a Worklog or Note</MudText>
    </TitleContent>
    <DialogContent>
        <div style="min-height: 400px;">
            <MudForm @ref="form" Model="newWorklog" @bind-IsValid="isValid">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="3">
                        <MudNumericField @bind-Value="newWorklog.Hours" Label="Hours" Variant="Variant.Outlined" Min="0" Max="24" Step="0.1" HideSpinButtons="true" />
                    </MudItem>
                    <MudItem xs="12" sm="9" Class="d-flex align-center">
                        <MudCheckBox T="bool"
                                     @bind-Value="newWorklog.IsInternalNote"
                                     Color="Color.Warning"
                                     Label="Internal note" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string"
                                      @bind-Value="newWorklog.Notes"
                                      Lines="14"
                                      Variant="Variant.Outlined"
                                      Placeholder="Enter your note details here..." />
                    </MudItem>
                </MudGrid>
            </MudForm>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(string.IsNullOrWhiteSpace(newWorklog.Notes))">Submit Note</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    private MudForm form = default!;
    private bool isValid;
    private CreateWorkLogDto newWorklog = new();

    private void Submit()
    {
        // The content of newWorklog is the result we pass back
        MudDialog.Close(DialogResult.Ok(newWorklog));
    }
    void Cancel() => MudDialog.Cancel();
}
