@using Helpdesk.Shared.DTOs.User
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar

<div @onclick:stopPropagation="true">

    <MudMenu Dense="true" Disabled="@ReadOnly"
             AnchorOrigin="Origin.CenterCenter"
             TransformOrigin="Origin.CenterCenter">

        <ActivatorContent>

            <MudTooltip Text="@Tooltip">

                <MudAvatar Class="cursor-pointer"
                           Size="Size.Small"
                           Color="Color.Default"
                           Variant="Variant.Outlined">

                    @Initials(User)

                </MudAvatar>

            </MudTooltip>

        </ActivatorContent>

        <ChildContent>

            <MudMenuItem OnClick="@(async () => await Assign(null))">
                Unassigned
            </MudMenuItem>

            @foreach (var user in availableUsers)
            {
                <MudMenuItem OnClick="@(async () => await Assign(user.Id))">
                    @user.Name (@user.Email)
                </MudMenuItem>
            }

        </ChildContent>

    </MudMenu>

</div>

@code {

    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string? OrganizationId { get; set; }
    private List<UserDto> availableUsers = new();
    private string? loadedOrganizationId;
    protected override async Task OnParametersSetAsync()
    {
        if (ReadOnly || string.IsNullOrWhiteSpace(OrganizationId) || loadedOrganizationId == OrganizationId) return;
        loadedOrganizationId = OrganizationId;
        try { availableUsers = await Api.GetFromJsonAsync<List<UserDto>>($"api/v1/ticketing/assignees?module={TicketType.TrimEnd('s')}&organizationId={Uri.EscapeDataString(OrganizationId)}") ?? new(); }
        catch (HttpRequestException) { availableUsers = new(); }
    }

    [Parameter] public string TicketId { get; set; } = default!;
    [Parameter] public string TicketType { get; set; } = default!;
    [Parameter] public string? AssignedToId { get; set; }

    [Parameter] public List<UserDto> TeamMembers { get; set; } = new();

    [Parameter] public EventCallback<string?> AssignedToIdChanged { get; set; }

    private HttpClient Api => HttpClientFactory.CreateClient("HelpdeskApi");

    private UserDto? User => availableUsers.Concat(TeamMembers).FirstOrDefault(x => x.Id == AssignedToId);

    private string Tooltip =>
        User is null
        ? (string.IsNullOrWhiteSpace(AssignedToId) ? "Unassigned" : "Assigned team member")
        : $"{User.Name} ({User.Email})";

    private async Task Assign(string? newUserId)
    {
        if (ReadOnly) return;
        try
        {
            var resp = await Api.PostAsJsonAsync(
                $"api/v1/{TicketType}/bulk/assign",
                new
                {
                    Ids = new[] { TicketId },
                    AssignedToId = newUserId
                });

            if (!resp.IsSuccessStatusCode)
            {
                Snackbar.Add("Assignment failed", Severity.Error);
                return;
            }

            AssignedToId = newUserId;

            await AssignedToIdChanged.InvokeAsync(newUserId);
        }
        catch
        {
            Snackbar.Add("Assignment failed", Severity.Error);
        }
    }

    private static string Initials(UserDto? u)
    {
        if (u is null)
            return "?";

        var name = u.Name ?? u.Email ?? "?";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
            return parts[0].Length >= 2
                ? parts[0][0].ToString().ToUpper() + parts[0][1].ToString().ToUpper()
                : parts[0][0].ToString().ToUpper();

        return parts[0][0].ToString().ToUpper()
             + parts[^1][0].ToString().ToUpper();
    }

}
