@using System.ComponentModel.DataAnnotations

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Add Email</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" Model="model">
            <MudTextField @bind-Value="model.Email"
                          For="@(()=> model.Email)"
                          Label="Email"
                          Variant="Variant.Outlined"
                          Required="true" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@(!form?.IsValid ?? true)">Add</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    private MudForm form = default!;
    private EmailInput model = new();

    private async Task Submit()
    {
        await form.Validate();
        if (form.IsValid)
        {
            Dialog.Close(DialogResult.Ok(model.Email.Trim()));
        }
    }

    private void Cancel() => Dialog.Cancel();

    private class EmailInput
    {
        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}
